      "operations": [
        {
          "name": "knn_pseudobulk",
          "qualified_name": "scwbrepresentation::knn_pseudobulk",
          "title": "kNN pseudobulk around query cells",
          "description": "Aggregate bounded matrix slices over authenticated nearest-neighbor memberships.",
          "runner": ".run_knn_pseudobulk",
          "inputs": [
            {
              "name": "matrix",
              "kind": "matrix",
              "required": true,
              "alignment": "cell_and_feature_ordered"
            },
            {
              "name": "space",
              "kind": "space",
              "required": true,
              "alignment": "cell_ordered"
            }
          ],
          "params_schema": {
            "type": "object",
            "required": [
              "query_cells"
            ],
            "properties": {
              "query_cells": {
                "type": [
                  "array",
                  "string"
                ],
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "candidate_cells": {
                "type": [
                  "array",
                  "string",
                  "null"
                ],
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "k": {
                "type": "integer",
                "default": 100,
                "minimum": 1
              },
              "include_query": {
                "type": "boolean",
                "default": false
              },
              "space_chunk_size": {
                "type": "integer",
                "default": 1024,
                "minimum": 1,
                "maximum": 1000000
              },
              "features": {
                "type": [
                  "array",
                  "null"
                ],
                "default": null,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "aggregate": {
                "type": "string",
                "default": "sum",
                "enum": [
                  "sum",
                  "mean"
                ]
              },
              "matrix_chunk_size": {
                "type": "integer",
                "default": 256,
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "additionalProperties": false
          },
          "parameter_bindings": [
            {
              "parameter": "features",
              "policy": "feature_ids_or_all_v1",
              "input": "matrix"
            }
          ],
          "cell_selector_axes": [
            {
              "parameter": "query_cells",
              "role": "query",
              "default_all_cells": false,
              "include_query_parameter": "include_query"
            },
            {
              "parameter": "candidate_cells",
              "role": "candidate",
              "default_all_cells": true,
              "include_query_parameter": "include_query"
            }
          ],
          "typed_space_reads": [
            {
              "name": "query_space",
              "input": "space",
              "reader": "read_typed_space",
              "kind": "space",
              "role": "query",
              "selection": {
                "policy": "parameter_cell_selector_v1",
                "parameter": "query_cells"
              },
              "chunk_size_parameter": "space_chunk_size",
              "call_discipline": "ordered_partition_exactly_once"
            },
            {
              "name": "candidate_space",
              "input": "space",
              "reader": "read_typed_space",
              "kind": "space",
              "role": "candidate",
              "selection": {
                "policy": "parameter_cell_selector_v1",
                "parameter": "candidate_cells"
              },
              "chunk_size_parameter": "space_chunk_size",
              "call_discipline": "ordered_partition_exactly_once"
            }
          ],
          "typed_slice_reads": [
            {
              "name": "matrix_chunks",
              "input": "matrix",
              "reader": "read_typed_slices",
              "kind": "matrix",
              "supported_axes": [
                "features"
              ],
              "chunk_axis": "features",
              "chunk_size_parameter": "matrix_chunk_size",
              "call_discipline": "ordered_partition_exactly_once",
              "empty_selection_policy": "reject",
              "duplicate_policy": "reject",
              "selection": {
                "cells": {
                  "policy": "parameter_ordered_subset_v1",
                  "parameter": "candidate_cells",
                  "unknown": "error",
                  "duplicates": "reject",
                  "order": "parameter_order"
                },
                "features": {
                  "policy": "parameter_ordered_subset_v1",
                  "parameter": "features",
                  "unknown": "error",
                  "duplicates": "reject",
                  "order": "parameter_order"
                }
              }
            }
          ],
          "dimension_policies": [
            {
              "output": "pseudobulk_table",
              "policy": "authenticated_pseudobulk_v1",
              "membership_output": "neighbor_distance",
