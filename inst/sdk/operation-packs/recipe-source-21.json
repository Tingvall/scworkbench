              "policy": "authenticated_sparse_membership_v1",
              "representation": "cell_vector_family",
              "partner_output": "neighbor_distance",
              "query_space_read": "query_space",
              "candidate_space_read": "candidate_space",
              "k_parameter": "k"
            }
          ],
          "outputs": [
