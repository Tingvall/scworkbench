              "parameter": "candidate_cells"
            },
            {
              "name": "n_features",
              "source": "parameter_count",
              "parameter": "features"
            },
            {
              "name": "k",
              "source": "effective_parameter_value",
              "parameter": "k"
            },
            {
              "name": "aggregate",
              "source": "effective_parameter_value",
              "parameter": "aggregate"
            },
            {
              "name": "include_query",
              "source": "effective_parameter_value",
              "parameter": "include_query"
            }
          ],
          "public_interface": {
            "intent": [
              "pseudobulk",
              "neighbors",
              "projection"
            ],
            "inputs": [
              {
                "name": "matrix",
                "label": "matrix",
                "help": "Feature-by-cell aggregation matrix."
              },
              {
                "name": "space",
                "label": "space",
                "help": "Cell-aligned embedding space."
              }
            ],
            "parameters": [
              {
                "name": "query_cells",
                "type": "cell_ids_or_set",
                "help": "kNN pseudobulk query_cells parameter."
              },
              {
                "name": "candidate_cells",
                "type": "cell_ids_or_set",
                "help": "kNN pseudobulk candidate_cells parameter."
              },
              {
                "name": "k",
                "type": "int",
                "help": "kNN pseudobulk k parameter."
              },
              {
                "name": "include_query",
                "type": "bool",
                "help": "kNN pseudobulk include_query parameter."
              },
              {
                "name": "space_chunk_size",
                "type": "int",
                "help": "kNN pseudobulk space_chunk_size parameter."
              },
              {
                "name": "features",
                "type": "string_vec",
                "help": "kNN pseudobulk features parameter."
              },
              {
                "name": "aggregate",
                "type": "choice",
                "help": "kNN pseudobulk aggregate parameter."
              },
              {
                "name": "matrix_chunk_size",
                "type": "int",
                "help": "kNN pseudobulk matrix_chunk_size parameter."
              }
            ],
            "outputs": [
