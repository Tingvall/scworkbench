              "name": "Matrix",
              "version": {
                "scheme": "r_package_version_constraint_v1",
                "specifier": ">=1.6.0,<2.0.0"
              },
              "disposition": "required",
              "import_probe": "rowSums"
            }
          ],
          "promotion_closure": {
            "pseudobulk_table": [
              "neighbor_distance",
