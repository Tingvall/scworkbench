                "specifier": ">=2.3.0,<3.0.0"
              },
              "disposition": "required",
              "import_probe": "prcomp_irlba"
            }
          ],
          "promotion_closure": {
            "loadings": [
              "fit_summary",
              "loadings",
              "space",
              "variance"
            ],
            "variance": [
              "fit_summary",
              "loadings",
              "space",
              "variance"
            ],
            "fit_summary": [
              "fit_summary",
              "loadings",
              "space",
              "variance"
            ]
          },
          "replay_equivalence": {
