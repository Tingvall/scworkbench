            "variance": "exact_canonical_value",
            "fit_summary": "exact_canonical_value"
          },
          "retained_parameters": [
            {
              "name": "feature_ids",
              "source": "effective_parameter_value",
              "parameter": "feature_ids",
              "required": true
            },
            {
              "name": "n_components",
              "source": "effective_parameter_value",
              "parameter": "n_components",
              "required": true
            },
            {
              "name": "center",
              "source": "effective_parameter_value",
              "parameter": "center",
              "required": true
            },
            {
              "name": "scale",
              "source": "effective_parameter_value",
              "parameter": "scale",
              "required": true
            },
            {
              "name": "backend",
              "source": "effective_parameter_value",
              "parameter": "backend",
              "required": true
            },
            {
              "name": "seed",
              "source": "effective_parameter_value",
              "parameter": "seed",
              "required": true
            },
            {
              "name": "space_id_out",
              "source": "effective_parameter_value",
              "parameter": "space_id_out",
              "required": true
            },
            {
              "name": "overwrite",
              "source": "effective_parameter_value",
              "parameter": "overwrite",
              "required": true
            },
            {
              "name": "max_dense_gb",
              "source": "effective_parameter_value",
              "parameter": "max_dense_gb",
              "required": true
            },
            {
              "name": "chunk_size",
              "source": "effective_parameter_value",
              "parameter": "chunk_size",
              "required": true
            }
          ],
          "public_interface": {
            "intent": [
              "matrix",
              "pca",
              "space"
            ],
            "inputs": [
              {
                "name": "matrix",
                "label": "matrix",
                "help": "Feature-by-cell input matrix."
              },
              {
                "name": "features",
                "label": "features",
                "help": "Optional selected feature table."
              }
            ],
            "parameters": [
              {
                "name": "feature_ids",
                "type": "string_vec",
                "help": "PCA feature_ids parameter."
              },
              {
                "name": "n_components",
                "type": "int",
                "help": "PCA n_components parameter."
              },
              {
                "name": "center",
                "type": "bool",
                "help": "PCA center parameter."
              },
              {
                "name": "scale",
                "type": "bool",
                "help": "PCA scale parameter."
              },
