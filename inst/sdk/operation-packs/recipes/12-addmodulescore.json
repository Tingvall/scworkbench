{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbgeneprograms",
  "package": {
    "name": "scwbGenePrograms",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbGenePrograms::register_operation_pack",
  "operations": [
    {
      "name": "addmodulescore",
      "qualified_name": "scwbgeneprograms::addmodulescore",
      "title": "Add module score",
      "description": "Seurat-style module scoring using matched control features by expression bin.",
      "runner": ".run_addmodulescore",
      "inputs": [
        {
          "name": "matrix",
          "kind": "matrix",
          "required": true,
          "alignment": "cell_and_feature_ordered"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "features": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "pool": {
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nbin": {
            "type": "integer",
            "default": 24,
            "minimum": 2,
            "maximum": 200
          },
          "ctrl": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 1000
          },
          "name": {
            "type": "string",
            "default": "Module",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "default": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "features"
        ]
      },
      "dimension_policies": [
        {
          "output": "module_scores",
          "policy": "authenticated_output_axes_v1",
          "shape": "cell_key_cartesian",
          "cell_axis": {
            "source": "effective_cells_v1",
            "input": "matrix"
          },
          "key_axis": {
            "source": "resolved_parameter_feature_groups_v1",
            "groups_parameter": "features",
            "matrix_input": "matrix",
            "name_prefix_parameter": "name",
            "matching": "exact_feature_id_v1",
            "normalization": "ordered_unique_features_v1",
            "generated_names": "legacy_module_group_names_v1",
            "missing_feature_policy": {
              "source": "fixed_drop_v1"
            },
            "empty_group_policy": "drop",
            "zero_key_policy": "error"
          },
          "row_order": "key_major_then_cell_v1",
          "missing_values": "forbidden"
        }
      ],
      "outputs": [
        {
          "name": "module_scores",
          "category": "terminal_artifact",
          "kind": "cell_vector_family",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "module_scores_id",
          "required": true,
          "promotion_group": "module_scores",
          "value_kind": "continuous"
        }
      ],
      "dependencies": [
        {
          "requirement_id": "scworkbench_runtime",
          "kind": "r_package",
          "name": "scworkbench",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<0.2.0"
          },
          "disposition": "required",
          "import_probe": "wb_prim_obs_table"
        },
        {
          "requirement_id": "matrix_runtime",
          "kind": "r_package",
          "name": "Matrix",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=1.3.0"
          },
          "disposition": "required",
          "import_probe": "colMeans"
        }
      ],
      "promotion_closure": {
        "module_scores": [
          "module_scores"
        ]
      },
      "replay_equivalence": {
        "module_scores": "exact_canonical_value"
      },
      "retained_parameters": [
        {
          "name": "module_definitions",
          "source": "parameter_value",
          "parameter": "features"
        }
      ],
      "public_interface": {
        "intent": [
          "expression",
          "signature",
          "score"
        ],
        "inputs": [
          {
            "name": "matrix",
            "label": "matrix",
            "help": "Typed matrix input."
          }
        ],
        "parameters": [
          {
            "name": "features",
            "type": "list",
            "help": "Module feature IDs: character vector or list of vectors."
          },
          {
            "name": "pool",
            "type": "string_vec",
            "help": "Optional control feature pool; defaults to all matrix features."
          },
          {
            "name": "nbin",
            "type": "int",
            "help": "Number of expression bins for control matching."
          },
          {
            "name": "ctrl",
            "type": "int",
            "help": "Control features sampled per module feature."
          },
          {
            "name": "name",
            "type": "string",
            "help": "Prefix for module names when features are unnamed."
          },
          {
            "name": "seed",
            "type": "int",
            "help": "Random seed for control sampling."
          }
        ],
        "outputs": [
          {
            "name": "module_scores",
            "description": "Per-cell module scores for one or more signatures."
          }
        ]
      }
    }
  ]
}
