{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbrepresentation",
  "package": {
    "name": "scwbRepresentation",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbRepresentation::register_operation_pack",
  "operations": [
    {
      "name": "knn_neighbors",
      "qualified_name": "scwbrepresentation::knn_neighbors",
      "title": "kNN neighbors around query cells",
      "description": "Find deterministic nearest neighbors across separately authenticated query and candidate axes.",
      "runner": ".run_knn_neighbors",
      "inputs": [
        {
          "name": "space",
          "kind": "space",
          "required": true,
          "alignment": "cell_ordered"
        }
      ],
      "params_schema": {
        "type": "object",
        "required": [
          "query_cells"
        ],
        "properties": {
          "query_cells": {
            "type": [
              "array",
              "string"
            ],
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "candidate_cells": {
            "type": [
              "array",
              "string",
              "null"
            ],
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "k": {
            "type": "integer",
            "default": 100,
            "minimum": 1
          },
          "include_query": {
            "type": "boolean",
            "default": false
          },
          "space_chunk_size": {
            "type": "integer",
            "default": 1024,
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "additionalProperties": false
      },
      "cell_selector_axes": [
        {
          "parameter": "query_cells",
          "role": "query",
          "default_all_cells": false,
          "include_query_parameter": "include_query"
        },
        {
          "parameter": "candidate_cells",
          "role": "candidate",
          "default_all_cells": true,
          "include_query_parameter": "include_query"
        }
      ],
      "typed_space_reads": [
        {
          "name": "query_space",
          "input": "space",
          "reader": "read_typed_space",
          "kind": "space",
          "role": "query",
          "selection": {
            "policy": "parameter_cell_selector_v1",
            "parameter": "query_cells"
          },
          "chunk_size_parameter": "space_chunk_size",
          "call_discipline": "ordered_partition_exactly_once"
        },
        {
          "name": "candidate_space",
          "input": "space",
          "reader": "read_typed_space",
          "kind": "space",
          "role": "candidate",
          "selection": {
            "policy": "parameter_cell_selector_v1",
            "parameter": "candidate_cells"
          },
          "chunk_size_parameter": "space_chunk_size",
          "call_discipline": "ordered_partition_exactly_once"
        }
      ],
      "dimension_policies": [
        {
          "output": "neighbors",
          "policy": "authenticated_sparse_membership_v1",
          "representation": "obs_table",
          "partner_output": "neighbor_distance",
          "query_space_read": "query_space",
          "candidate_space_read": "candidate_space",
          "k_parameter": "k"
        },
        {
          "output": "neighbor_distance",
          "policy": "authenticated_sparse_membership_v1",
          "representation": "cell_vector_family",
          "partner_output": "neighbors",
          "query_space_read": "query_space",
          "candidate_space_read": "candidate_space",
          "k_parameter": "k"
        }
      ],
      "outputs": [
        {
          "name": "neighbors",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "neighbors_id",
          "required": true,
          "promotion_group": "knn",
          "table_type": "knn_neighbors"
        },
        {
          "name": "neighbor_distance",
          "category": "terminal_artifact",
          "kind": "cell_vector_family",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "neighbor_distance_id",
          "required": true,
          "promotion_group": "knn",
          "value_kind": "continuous"
        }
      ],
      "dependencies": [
        {
          "requirement_id": "scworkbench_runtime",
          "kind": "r_package",
          "name": "scworkbench",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<0.2.0"
          },
          "disposition": "required",
          "import_probe": "wb_prim_cell_vector_family"
        }
      ],
      "promotion_closure": {
        "neighbors": [
          "neighbor_distance",
          "neighbors"
        ],
        "neighbor_distance": [
          "neighbor_distance",
          "neighbors"
        ]
      },
      "replay_equivalence": {
        "neighbors": "exact_canonical_value",
        "neighbor_distance": "exact_canonical_value"
      },
      "retained_parameters": [
        {
          "name": "space_id",
          "source": "output_meta",
          "output": "neighbors",
          "field": "space_id"
        },
        {
          "name": "n_query",
          "source": "parameter_count",
          "parameter": "query_cells"
        },
        {
          "name": "n_candidates",
          "source": "parameter_count",
          "parameter": "candidate_cells"
        },
        {
          "name": "k",
          "source": "effective_parameter_value",
          "parameter": "k"
        },
        {
          "name": "include_query",
          "source": "effective_parameter_value",
          "parameter": "include_query"
        }
      ],
      "public_interface": {
        "intent": [
          "neighbors",
          "geometry",
          "projection"
        ],
        "inputs": [
          {
            "name": "space",
            "label": "space",
            "help": "Cell-aligned embedding space."
          }
        ],
        "parameters": [
          {
            "name": "query_cells",
            "type": "cell_ids_or_set",
            "help": "kNN query_cells parameter."
          },
          {
            "name": "candidate_cells",
            "type": "cell_ids_or_set",
            "help": "kNN candidate_cells parameter."
          },
          {
            "name": "k",
            "type": "int",
            "help": "kNN k parameter."
          },
          {
            "name": "include_query",
            "type": "bool",
            "help": "kNN include_query parameter."
          },
          {
            "name": "space_chunk_size",
            "type": "int",
            "help": "kNN space_chunk_size parameter."
          }
        ],
        "outputs": [
          {
            "name": "neighbors",
            "description": "Ranked query-to-candidate neighbor table."
          },
          {
            "name": "neighbor_distance",
            "description": "Sparse query-keyed candidate distance family."
          }
        ]
      }
    }
  ]
}
