{
  "backend": "R",
  "compatibility": {
    "pack_abi": {
      "maximum": "3",
      "minimum": "3"
    },
    "scworkbench": {
      "maximum_exclusive": "0.2.0",
      "minimum": "0.1.0"
    }
  },
  "entry_point": "scwbRNA::register_operation_pack",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbrna",
  "operations": [
    {
      "dependencies": [
        {
          "disposition": "required",
          "import_probe": "wb_prim_cell_vector_family",
          "kind": "r_package",
          "name": "scworkbench",
          "requirement_id": "scworkbench_runtime",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<1.0.0"
          }
        },
        {
          "disposition": "required",
          "import_probe": "colSums",
          "kind": "r_package",
          "name": "Matrix",
          "requirement_id": "matrix_runtime",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=1.3.0"
          }
        }
      ],
      "description": "Calculate count depth, detected-feature count, and explicitly defined mitochondrial/ribosomal metrics without filtering cells.",
      "dimension_policies": [
        {
          "cell_axis": {
            "input": "matrix",
            "source": "effective_cells_v1"
          },
          "key_axis": {
            "group_order": "manifest_order_v1",
            "optional_groups": [
              {
                "keys": [
                  "mitochondrial_counts",
                  "mitochondrial_percent"
                ],
                "name": "mitochondrial"
              },
              {
                "keys": [
                  "ribosomal_counts",
                  "ribosomal_percent"
                ],
                "name": "ribosomal"
              }
            ],
            "required_keys": [
              "total_counts",
              "detected_features"
            ],
            "selection_owner": "operation_pack_v1",
            "source": "declared_bounded_key_groups_v1"
          },
          "missing_values": "forbidden",
          "output": "metrics",
          "policy": "authenticated_output_axes_v1",
          "row_order": "key_major_then_cell_v1",
          "shape": "bounded_grouped_cell_key_cartesian"
        },
        {
          "output": "qc_features",
          "policy": "data_dependent_table_v1"
        },
        {
          "output": "summary",
          "policy": "data_dependent_table_v1"
        }
      ],
      "inputs": [
        {
          "alignment": "cell_and_feature_ordered",
          "kind": "matrix",
          "name": "matrix",
          "required": true
        }
      ],
      "name": "rna_qc_metrics",
      "outputs": [
        {
          "allocated_id_key": "metrics_id",
          "category": "terminal_artifact",
          "kind": "cell_vector_family",
          "name": "metrics",
          "promotion_group": "qc",
          "required": true,
          "storage_profile": "terminal_primitive_v1",
          "value_kind": "continuous"
        },
        {
          "allocated_id_key": "qc_features_id",
          "category": "terminal_artifact",
          "kind": "feature_table",
          "name": "qc_features",
          "promotion_group": "qc",
          "required": true,
          "storage_profile": "terminal_primitive_v1",
          "table_type": "rna_qc_feature_membership"
        },
        {
          "allocated_id_key": "summary_id",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "name": "summary",
          "promotion_group": "qc",
          "required": true,
          "storage_profile": "terminal_primitive_v1",
          "table_type": "rna_qc_metrics_summary"
        }
      ],
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "chunk_size": {
            "default": 2000,
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          },
          "integer_tolerance": {
            "default": 1e-08,
            "minimum": 0,
            "type": "number"
          },
          "missing_feature_policy": {
            "default": "error",
            "enum": [
              "error",
              "drop"
            ],
            "type": "string"
          },
          "mitochondrial_features": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true
          },
          "mitochondrial_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "pattern_ignore_case": {
            "default": false,
            "type": "boolean"
          },
          "require_integer_counts": {
            "default": true,
            "type": "boolean"
          },
          "ribosomal_features": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true
          },
          "ribosomal_pattern": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "promotion_closure": {
        "metrics": [
          "metrics",
          "qc_features",
          "summary"
        ],
        "qc_features": [
          "metrics",
          "qc_features",
          "summary"
        ],
        "summary": [
          "metrics",
          "qc_features",
          "summary"
        ]
      },
      "qualified_name": "scwbrna::rna_qc_metrics",
      "replay_equivalence": {
        "metrics": "exact_canonical_value",
        "qc_features": "exact_canonical_value",
        "summary": "exact_canonical_value"
      },
      "retained_parameters": [
        {
          "name": "mitochondrial_features",
          "parameter": "mitochondrial_features",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "mitochondrial_pattern",
          "parameter": "mitochondrial_pattern",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "ribosomal_features",
          "parameter": "ribosomal_features",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "ribosomal_pattern",
          "parameter": "ribosomal_pattern",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "pattern_ignore_case",
          "parameter": "pattern_ignore_case",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "missing_feature_policy",
          "parameter": "missing_feature_policy",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "require_integer_counts",
          "parameter": "require_integer_counts",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "integer_tolerance",
          "parameter": "integer_tolerance",
          "required": false,
          "source": "parameter_value"
        },
        {
          "name": "chunk_size",
          "parameter": "chunk_size",
          "required": false,
          "source": "parameter_value"
        }
      ],
      "runner": ".run_rna_qc_metrics",
      "title": "Calculate per-cell RNA QC metrics",
      "typed_slice_reads": [
        {
          "call_discipline": "ordered_partition_exactly_once",
          "chunk_axis": "cells",
          "chunk_size_parameter": "chunk_size",
          "duplicate_policy": "reject",
          "empty_selection_policy": "reject",
          "input": "matrix",
          "kind": "matrix",
          "name": "matrix_chunks",
          "reader": "read_typed_slices",
          "selection": {
            "cells": {
              "policy": "effective_input_axis_v1"
            },
            "features": {
              "policy": "effective_input_axis_v1"
            }
          },
          "supported_axes": [
            "cells"
          ]
        }
      ]
    }
  ],
  "pack_abi_version": "3",
  "package": {
    "name": "scwbRNA",
    "version": "0.1.0"
  },
  "schema_version": "scworkbench.operation_pack.v3"
}
