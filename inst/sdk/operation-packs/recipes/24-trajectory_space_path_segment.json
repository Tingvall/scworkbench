            "maximum_source_memberships": 20000000,
            "maximum_linked_outputs": 3
          },
          "call_discipline": "declare_once_seal_before_linked_output_v1",
          "closure_policy": "all_linked_outputs_and_axis_observation_required_v1",
          "declaration_identity": {
            "scheme": "scworkbench.operation_pack.derived_cell_output_axis.v1",
            "scope": "derived cell output axis declaration excluding declaration_identity",
            "sha256": "f7a5d068258588ee2e0a081d725444d6244e98e2097d4c62bf23c1927ad18521"
          }
        }
