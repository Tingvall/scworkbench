            "schema": "scworkbench.operation_pack.derived_fitted_axis_policy.v1",
            "mode": "source_relative_subset_v1",
            "source_space_input": "source",
            "model_output": "model",
            "required_siblings": [
              {
                "name": "embedding",
                "kind": "cell_vector",
                "coverage_policy": "exact_fitted_axis_v1"
              },
              {
                "name": "weights",
                "kind": "cell_vector_family",
                "coverage_policy": "per_key_source_relative_subset_v1"
              }
            ],
            "declaration_discipline": "exactly_once_before_cell_indexed_writes",
            "maximum_selected_cells": 1000000,
            "maximum_combined_id_bytes": 67108864,
            "maximum_id_bytes": 1024,
            "maximum_family_keys": 64,
            "policy_identity": {
              "scheme": "scworkbench.operation_pack.derived_fitted_axis_policy.v1",
