{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbv3matrixmodel",
  "package": {
    "name": "scwbV3MatrixModel",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbV3MatrixModel::register_operation_pack",
  "operations": [
    {
      "name": "read_matrix_model",
      "qualified_name": "scwbv3matrixmodel::read_matrix_model",
      "title": "Read synthetic matrix model",
      "description": "Reopens matrix-trained contained-model bytes through G1.",
      "runner": ".read_matrix_model",
      "inputs": [
        {
          "name": "model",
          "kind": "model_ref",
          "required": true,
          "alignment": "model_linked"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "self_linked_contained_model_reads": [
        {
          "name": "model_tree",
          "input": "model",
          "reader": "read_self_linked_contained_model_payload",
          "allowed_models": [
            {
              "engine": "fixture",
              "model_type": "matrix_model"
            }
          ],
          "linkage_policy": "authenticated_existing_source_and_cell_linkage_v1",
          "maximum_file_count": 32,
          "maximum_total_bytes": 1073741824,
          "call_discipline": "exactly_once"
        }
      ],
      "dimension_policies": [
        {
          "output": "summary",
          "policy": "data_dependent_table_v1"
        }
      ],
      "outputs": [
        {
          "name": "summary",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "summary_id",
          "required": true,
          "promotion_group": "summary",
          "table_type": "matrix_model_read_summary"
        }
      ],
      "dependencies": [],
      "promotion_closure": {
        "summary": [
          "summary"
        ]
      },
      "replay_equivalence": {
        "summary": "exact_canonical_value"
      }
    }
  ]
}
