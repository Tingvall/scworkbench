{
  "backend": "R",
  "compatibility": {
    "pack_abi": {
      "maximum": "3",
      "minimum": "3"
    },
    "scworkbench": {
      "maximum_exclusive": "0.2.0",
      "minimum": "0.1.0"
    }
  },
  "entry_point": "scwbRNA::register_operation_pack",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbrna",
  "operations": [
    {
      "dependencies": [
        {
          "disposition": "required",
          "import_probe": "wb_prim_obs_table",
          "kind": "r_package",
          "name": "scworkbench",
          "requirement_id": "scworkbench_runtime",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<1.0.0"
          }
        },
        {
          "disposition": "required",
          "import_probe": "colSums",
          "kind": "r_package",
          "name": "Matrix",
          "requirement_id": "matrix_runtime",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=1.3.0"
          }
        }
      ],
      "description": "Create an authenticated fragment-backed log1p(counts / library_size * scale_factor) matrix.",
      "dimension_policies": [
        {
          "output": "summary",
          "policy": "data_dependent_table_v1"
        }
      ],
      "inputs": [
        {
          "alignment": "cell_and_feature_ordered",
          "kind": "matrix",
          "name": "matrix",
          "required": true
        }
      ],
      "name": "matrix_log_normalize",
      "outputs": [
        {
          "allocated_id_key": "matrix_id",
          "category": "materialization",
          "fragment_policy": {
            "cell_coverage": "exact_source_cell_order_partition_v1",
            "feature_coverage": "exact_source_feature_order_v1",
            "fragment_axis": "cells",
            "fragment_order": "source_fragment_then_part_v1",
            "minimum_fragment_count": 1,
            "policy": "staged_matrix_fragments_v1",
            "source_fragment_binding": "single_parent_no_crossing_v1",
            "source_input": "matrix",
            "source_typed_slice_read": "matrix_chunks"
          },
          "kind": "matrix",
          "materialized_by_terminals": [
            "summary"
          ],
          "name": "matrix",
          "promotion_group": "normalization",
          "required": true,
          "storage_profile": "matrix_backed_chunked_v1"
        },
        {
          "allocated_id_key": "summary_id",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "name": "summary",
          "promotion_group": "normalization",
          "required": true,
          "storage_profile": "terminal_primitive_v1",
          "table_type": "matrix_log_normalize_summary"
        }
      ],
      "parameter_bindings": [
        {
          "affix": "_log1p_cp",
          "input": "matrix",
          "numeric_parameter": "scale_factor",
          "parameter": "output_matrix_id",
          "policy": "input_id_with_numeric_suffix_v1"
        }
      ],
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "chunk_size": {
            "default": 2000,
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          },
          "output_matrix_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          },
          "scale_factor": {
            "default": 10000,
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "promotion_closure": {
        "summary": [
          "matrix",
          "summary"
        ]
      },
      "publication_policies": [
        {
          "output": "matrix",
          "overwrite_parameter": "overwrite",
          "policy": "authenticated_add_or_replace_v1",
          "target_id_parameter": "output_matrix_id",
          "target_kind": "matrix",
          "transaction_scope": "promotion_group_v1"
        }
      ],
      "qualified_name": "scwbrna::matrix_log_normalize",
      "replay_equivalence": {
        "matrix": "exact_canonical_value",
        "summary": "exact_canonical_value"
      },
      "retained_parameters": [
        {
          "name": "output_matrix_id",
          "parameter": "output_matrix_id",
          "required": true,
          "source": "effective_parameter_value"
        },
        {
          "name": "scale_factor",
          "parameter": "scale_factor",
          "required": true,
          "source": "effective_parameter_value"
        },
        {
          "name": "overwrite",
          "parameter": "overwrite",
          "required": true,
          "source": "effective_parameter_value"
        },
        {
          "name": "chunk_size",
          "parameter": "chunk_size",
          "required": true,
          "source": "effective_parameter_value"
        }
      ],
      "runner": ".run_matrix_log_normalize",
      "title": "Log-normalize count matrix",
      "typed_slice_reads": [
        {
          "call_discipline": "ordered_partition_exactly_once",
          "chunk_axis": "cells",
          "chunk_size_parameter": "chunk_size",
          "duplicate_policy": "reject",
          "empty_selection_policy": "reject",
          "input": "matrix",
          "kind": "matrix",
          "name": "matrix_chunks",
          "reader": "read_typed_slices",
          "selection": {
            "cells": {
              "policy": "effective_input_axis_v1"
            },
            "features": {
              "policy": "effective_input_axis_v1"
            }
          },
          "supported_axes": [
            "cells"
          ]
        }
      ]
    }
  ],
  "pack_abi_version": "3",
  "package": {
    "name": "scwbRNA",
    "version": "0.1.0"
  },
  "schema_version": "scworkbench.operation_pack.v3"
}
