{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbrepresentation",
  "package": {
    "name": "scwbRepresentation",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbRepresentation::register_operation_pack",
  "operations": [
    {
      "name": "umap_fit",
      "qualified_name": "scwbrepresentation::umap_fit",
      "title": "UMAP fit",
      "description": "Fit UMAP from an authenticated space and publish a paired embedding and contained loadable model.",
      "runner": ".run_umap_fit",
      "inputs": [
        {
          "name": "space",
          "kind": "space",
          "required": true,
          "alignment": "cell_ordered"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "dims": {
            "type": [
              "array",
              "null"
            ],
            "default": null,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "space_id_out": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "minLength": 1
          },
          "n_neighbors": {
            "type": "integer",
            "default": 30,
            "minimum": 2,
            "maximum": 100000
          },
          "min_dist": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 1
          },
          "metric": {
            "type": "string",
            "default": "euclidean",
            "minLength": 1
          },
          "nn_method": {
            "type": "string",
            "default": "nndescent",
            "enum": [
              "nndescent",
              "annoy",
              "fnn"
            ]
          },
          "spread": {
            "type": "number",
            "default": 1,
            "minimum": 0
          },
          "seed": {
            "type": "integer",
            "default": 1
          }
        },
        "additionalProperties": false
      },
      "parameter_bindings": [
        {
          "parameter": "space_id_out",
          "policy": "input_id_with_literal_affix_v1",
          "input": "space",
          "affix": "umap."
        }
      ],
      "publication_policies": [
        {
          "output": "space_2d",
          "policy": "authenticated_space_2d_publication_v1",
          "target_kind": "space_2d",
          "target_id_parameter": "space_id_out",
          "mode": {
            "policy": "add_only_v1"
          },
          "cell_axis_input": "space",
          "model_binding": {
            "source": "sibling_output",
            "name": "model"
          },
          "transaction_scope": "promotion_group_v1"
        }
      ],
      "outputs": [
        {
          "name": "model",
          "category": "terminal_artifact",
          "kind": "model_ref",
          "storage_profile": "model_ref_contained_tree_v1",
          "allocated_id_key": "model_id",
          "required": true,
          "promotion_group": "umap",
          "contained_model_policy": {
            "policy": "staged_contained_model_tree_v1",
            "engine": "uwot",
            "model_type": "uwot_umap",
            "primary_path": "model.uwot",
            "source_space_input": "space",
            "paired_space_output": "space_2d",
            "dimensions_parameter": "dims",
            "file_order": "utf8_path_lexicographic_v1",
            "maximum_file_count": 32,
            "maximum_total_bytes": 1073741824
          }
        },
        {
          "name": "space_2d",
          "category": "materialization",
          "kind": "space_2d",
          "storage_profile": "space_2d_dense_v1",
          "allocated_id_key": "space_id",
          "required": true,
          "promotion_group": "umap",
          "materialized_by_terminals": [
            "model"
          ]
        }
      ],
      "dependencies": [
        {
          "requirement_id": "scworkbench_runtime",
          "kind": "r_package",
          "name": "scworkbench",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<0.2.0"
          },
          "disposition": "required",
          "import_probe": "wb_prim_model_ref"
        },
        {
          "requirement_id": "uwot_runtime",
          "kind": "r_package",
          "name": "uwot",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.2.0,<1.0.0"
          },
          "disposition": "required",
          "import_probe": "umap"
        }
      ],
      "promotion_closure": {
        "model": [
          "model",
          "space_2d"
        ]
      },
      "replay_equivalence": {
        "model": "loadable_reference",
        "space_2d": "cell_aligned_embedding"
      },
      "retained_parameters": [
        {
          "name": "dims",
          "source": "effective_parameter_value",
          "parameter": "dims",
          "required": true
        },
        {
          "name": "space_id_out",
          "source": "effective_parameter_value",
          "parameter": "space_id_out",
          "required": true
        },
        {
          "name": "n_neighbors",
          "source": "effective_parameter_value",
          "parameter": "n_neighbors",
          "required": true
        },
        {
          "name": "min_dist",
          "source": "effective_parameter_value",
          "parameter": "min_dist",
          "required": true
        },
        {
          "name": "metric",
          "source": "effective_parameter_value",
          "parameter": "metric",
          "required": true
        },
        {
          "name": "nn_method",
          "source": "effective_parameter_value",
          "parameter": "nn_method",
          "required": true
        },
        {
          "name": "spread",
          "source": "effective_parameter_value",
          "parameter": "spread",
          "required": true
        },
        {
          "name": "seed",
          "source": "effective_parameter_value",
          "parameter": "seed",
          "required": true
        }
      ],
      "public_interface": {
        "intent": [
          "umap",
          "fit"
        ],
        "inputs": [
          {
            "name": "space",
            "label": "space",
            "help": "Cell-aligned source space."
          }
        ],
        "parameters": [
          {
            "name": "dims",
            "type": "list",
            "help": "UMAP fit dims parameter."
          },
          {
            "name": "space_id_out",
            "type": "string",
            "help": "UMAP fit space_id_out parameter."
          },
          {
            "name": "n_neighbors",
            "type": "int",
            "help": "UMAP fit n_neighbors parameter."
          },
          {
            "name": "min_dist",
            "type": "dbl",
            "help": "UMAP fit min_dist parameter."
          },
          {
            "name": "metric",
            "type": "string",
            "help": "UMAP fit metric parameter."
          },
          {
            "name": "nn_method",
            "type": "choice",
            "help": "UMAP fit nn_method parameter."
          },
          {
            "name": "spread",
            "type": "dbl",
            "help": "UMAP fit spread parameter."
          },
          {
            "name": "seed",
            "type": "int",
            "help": "UMAP fit seed parameter."
          }
        ],
        "outputs": [
          {
            "name": "model",
            "description": "Contained loadable uwot model reference."
          },
          {
            "name": "space_2d",
            "description": "Fitted UMAP coordinates."
          }
        ]
      }
    }
  ]
}
