{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbv3phase5",
  "package": {
    "name": "scwbV3Phase5",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbV3Phase5::register_operation_pack",
  "operations": [
    {
      "name": "fit_sibling_model",
      "qualified_name": "scwbv3phase5::fit_sibling_model",
      "title": "Sibling model fixture",
      "description": "Publishes a contained model with a terminal sibling and no paired two-dimensional output.",
      "runner": ".fit_sibling_model",
      "inputs": [
        {
          "name": "source",
          "kind": "space",
          "required": true,
          "alignment": "cell_ordered"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "dims": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "dims"
        ],
        "additionalProperties": false
      },
      "dimension_policies": [
        {
          "output": "embedding",
          "policy": "authenticated_output_axes_v1",
          "shape": "one_per_cell",
          "cell_axis": {
            "source": "effective_cells_v1",
            "input": "source"
          },
          "row_order": "input_cell_order_v1",
          "missing_values": "forbidden"
        }
      ],
      "outputs": [
        {
          "name": "model",
          "category": "terminal_artifact",
          "kind": "model_ref",
          "storage_profile": "model_ref_contained_tree_v1",
          "allocated_id_key": "model_id",
          "required": true,
          "promotion_group": "fit",
          "contained_model_sibling_closure_policy": {
            "policy": "staged_contained_model_sibling_closure_v1",
            "engine": "fixture",
            "model_type": "phase5_model",
            "primary_path": "model.bin",
            "source_space_input": "source",
            "dimensions_parameter": "dims",
            "required_sibling_terminals": [
              "embedding"
            ],
            "file_order": "utf8_path_lexicographic_v1",
            "maximum_file_count": 32,
            "maximum_total_bytes": 1073741824
          }
        },
        {
          "name": "embedding",
          "category": "terminal_artifact",
          "kind": "cell_vector",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "embedding_id",
          "required": true,
          "promotion_group": "fit",
          "value_kind": "continuous"
        }
      ],
      "dependencies": [],
      "promotion_closure": {
        "model": [
          "embedding",
          "model"
        ],
        "embedding": [
          "embedding",
          "model"
        ]
      },
      "replay_equivalence": {
        "model": "loadable_reference",
        "embedding": "exact_canonical_value"
      }
    }
  ]
}
