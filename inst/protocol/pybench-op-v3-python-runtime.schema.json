{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scworkbench.org/protocol/pybench-op-v3-python-runtime.schema.json",
  "title": "PyBench operation-pack v3 Python runtime sidecar",
  "description": "Python-specific runtime evidence accompanying, but not extending, the shared ABI-v2 transition receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backend", "distribution_identity", "interpreter", "seed", "device", "runtime_identity"],
  "properties": {
    "schema": {"const": "pybench.operation_pack.python_runtime.v3"},
    "backend": {"const": "Python"},
    "distribution_identity": {"$ref": "#/$defs/identity"},
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "abi", "platform", "executable_sha256"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "abi": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"enum": ["declared", "not_declared"]},
        "value": {"type": ["integer", "null"]}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "descriptor"],
      "properties": {
        "type": {"enum": ["cpu", "cuda", "metal"]},
        "descriptor": {"type": "string", "minLength": 1}
      }
    },
    "chunk_observation": {"$ref": "#/$defs/chunk_observation"},
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "sha256"],
      "properties": {
        "scheme": {"const": "pybench.operation_pack.python_runtime.v3"},
        "scope": {"const": "python runtime sidecar excluding runtime_identity"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "sha256"],
      "properties": {
        "scheme": {"const": "scworkbench.operation_pack.content.v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "request_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "sha256"],
      "properties": {
        "scheme": {"const": "scworkbench.operation_pack.transition_request.v2"},
        "scope": {"const": "request excluding request_identity"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capability_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "sha256"],
      "properties": {
        "scheme": {"const": "scworkbench.operation_pack.capability.v2"},
        "scope": {"const": "capability excluding capability_identity"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operation_definition_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "sha256"],
      "properties": {
        "scheme": {"const": "scworkbench.operation_pack.definition.v2"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_descriptor_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "scope", "sha256"],
      "properties": {
        "scheme": {"const": "scworkbench.operation_pack.input_descriptor.v2"},
        "scope": {"const": "descriptor excluding descriptor_identity"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chunk_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_identity", "capability_identity", "operation_definition_identity",
        "input_name", "input_descriptor_identity", "axis", "sequence_parameter",
        "size_parameter", "requested_chunk_size", "observed_call_count",
        "observed_batches", "observed_batch_sizes", "observation_identity"
      ],
      "properties": {
        "request_identity": {"$ref": "#/$defs/request_identity"},
        "capability_identity": {"$ref": "#/$defs/capability_identity"},
        "operation_definition_identity": {"$ref": "#/$defs/operation_definition_identity"},
        "input_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "input_descriptor_identity": {"$ref": "#/$defs/input_descriptor_identity"},
        "axis": {"const": "features"},
        "sequence_parameter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "size_parameter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "requested_chunk_size": {"type": "integer", "minimum": 1},
        "observed_call_count": {"type": "integer", "minimum": 1},
        "observed_batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "observed_batch_sizes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "observation_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "scope", "sha256"],
          "properties": {
            "scheme": {"const": "pybench.operation_pack.chunk_observation.v1"},
            "scope": {"const": "chunk observation excluding observation_identity"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
