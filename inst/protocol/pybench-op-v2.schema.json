{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scworkbench.dev/protocol/pybench-op-v2.schema.json",
  "title": "scworkbench PyBench operation protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "source_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "content_sha256"],
      "properties": {
        "scheme": { "const": "scworkbench-scientific-state-v1" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "staging_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_sha256", "checkpoint_generation"],
      "properties": {
        "root_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_generation": { "$ref": "#/$defs/nonempty" }
      }
    },
    "key_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "values"],
      "properties": {
        "column": { "$ref": "#/$defs/nonempty" },
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" }, "uniqueItems": true }
      }
    },
    "write_allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_name", "output_id", "output_kind", "mutation_class"],
      "properties": {
        "output_name": { "$ref": "#/$defs/nonempty" },
        "output_id": { "$ref": "#/$defs/nonempty" },
        "output_kind": { "$ref": "#/$defs/nonempty" },
        "mutation_class": { "enum": ["sqlite_rows", "payload_tree"] },
        "table": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/path" },
        "key_scope": { "$ref": "#/$defs/key_scope" },
        "row_count": { "type": "integer", "minimum": 0 },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "mutation_class": { "const": "sqlite_rows" } } },
          "then": { "required": ["table", "key_scope"], "not": { "required": ["path"] } },
          "else": { "required": ["path"], "not": { "anyOf": [{ "required": ["table"] }, { "required": ["key_scope"] }] } }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "mode", "session_id", "run_id", "source_attestation", "staging_identity", "write_allowlist"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/nonempty" },
        "mode": { "enum": ["read_only", "staging_write"] },
        "session_id": { "$ref": "#/$defs/nonempty" },
        "run_id": { "$ref": "#/$defs/nonempty" },
        "source_attestation": { "$ref": "#/$defs/source_attestation" },
        "staging_identity": { "$ref": "#/$defs/staging_identity" },
        "write_allowlist": { "type": "array", "items": { "$ref": "#/$defs/write_allowance" } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact_id", "type"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonempty" },
        "type": { "$ref": "#/$defs/nonempty" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "protocol_version", "bundle_dir", "path_contract", "op_name", "run", "execution_capability", "inputs", "params", "outputs"],
      "properties": {
        "message_type": { "const": "request" },
        "protocol_version": { "const": "pybench-op-v2" },
        "bundle_dir": { "$ref": "#/$defs/nonempty" },
        "path_contract": { "type": "object" },
        "op_name": { "$ref": "#/$defs/nonempty" },
        "run": {
          "type": "object", "additionalProperties": false, "required": ["session_id", "run_id"],
          "properties": { "session_id": { "$ref": "#/$defs/nonempty" }, "run_id": { "$ref": "#/$defs/nonempty" } }
        },
        "execution_capability": { "$ref": "#/$defs/capability" },
        "inputs": { "type": "object" },
        "params": { "type": "object" },
        "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/output" } }
      }
    },
    "write_descriptor": {
      "allOf": [
        { "$ref": "#/$defs/write_allowance" },
        {
          "type": "object",
          "required": ["row_count", "content_sha256"],
          "properties": {
            "row_count": { "type": "integer", "minimum": 0 },
            "content_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "protocol_version", "status", "op_name", "run_id", "capability_echo"],
      "properties": {
        "message_type": { "const": "receipt" },
        "protocol_version": { "const": "pybench-op-v2" },
        "status": { "enum": ["ok", "error"] },
        "op_name": { "$ref": "#/$defs/nonempty" },
        "run_id": { "$ref": "#/$defs/nonempty" },
        "capability_echo": { "$ref": "#/$defs/capability" },
        "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/output" } },
        "write_manifest": { "type": "array", "items": { "$ref": "#/$defs/write_descriptor" } },
        "error_class": { "$ref": "#/$defs/nonempty" },
        "message": { "$ref": "#/$defs/nonempty" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": { "required": ["outputs", "write_manifest"] },
          "else": { "required": ["error_class", "message"] }
        }
      ]
    }
  }
}
