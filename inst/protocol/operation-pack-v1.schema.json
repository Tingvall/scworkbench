{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scworkbench.org/protocol/operation-pack-v1.schema.json",
  "title": "scworkbench operation pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "namespace", "package", "backend", "compatibility", "entry_point", "operations"],
  "properties": {
    "schema_version": {"const": "scworkbench.operation_pack.v1"},
    "protocol_version": {"const": "1"},
    "identity_scheme": {"const": "scworkbench.operation_pack.canonical_json.v1"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "package": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "backend": {"enum": ["R", "Python"]},
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["scworkbench", "protocol"],
      "properties": {"scworkbench": {"type": "string"}, "protocol": {"const": "1"}}
    },
    "entry_point": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "title", "description", "intent", "requires", "inputs", "params", "produces", "promotable", "replay_equivalence", "determinism", "resources", "software"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*::[a-z][a-z0-9_]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "intent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requires": {"type": "object", "additionalProperties": {"$ref": "#/$defs/primitive"}},
          "optional_requires": {"type": "object", "additionalProperties": {"$ref": "#/$defs/primitive"}},
          "inputs": {"type": "object", "additionalProperties": {"type": "object"}},
          "params": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
          "produces": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/primitive"}},
          "promotable": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replay_equivalence": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["exact_canonical_value", "loadable_reference", "cell_aligned_embedding", "not_comparable"]}},
          "coverage": {"type": "object", "additionalProperties": {"enum": ["cell_indexed", "reference_only", "model_associated_unless_query_space"]}},
          "interface_produces": {"type": "object", "additionalProperties": {"type": "object"}},
          "chunking": {"type": ["object", "null"]},
          "determinism": {"type": "object"},
          "resources": {"type": "object"},
          "software": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"backend": {"const": "R"}}, "required": ["backend"]},
      "then": {
        "properties": {
          "package": {
            "properties": {
              "name": {"pattern": "^[A-Za-z][A-Za-z0-9.]*$"},
              "version": {"pattern": "^[0-9]+(?:[.-][0-9A-Za-z]+)*$"}
            }
          },
          "entry_point": {"pattern": "^[A-Za-z][A-Za-z0-9._]*$"}
        }
      }
    },
    {
      "if": {"properties": {"backend": {"const": "Python"}}, "required": ["backend"]},
      "then": {
        "properties": {
          "package": {
            "properties": {
              "name": {"pattern": "^(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9])$"},
              "version": {"pattern": "^[vV]?(?:[0-9]+!)?[0-9]+(?:[.][0-9]+)*(?:[-_.]?(?:alpha|a|beta|b|preview|pre|c|rc)[-_.]?[0-9]*)?(?:(?:-[0-9]+)|(?:[-_.]?(?:post|rev|r)[-_.]?[0-9]*))?(?:[-_.]?dev[-_.]?[0-9]*)?(?:[+][A-Za-z0-9]+(?:[-_.][A-Za-z0-9]+)*)?$"}
            }
          },
          "entry_point": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
        }
      }
    }
  ],
  "$defs": {
    "primitive": {"enum": ["matrix", "space", "space_2d", "cell_vector", "cell_vector_family", "relation_family", "feature_table", "obs_table", "model_ref", "path_2d_family", "space_path_family"]},
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "help"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["int", "int_range", "int_vec", "dbl", "number", "bool", "logical", "string", "path", "cell_set", "choice", "string_vec", "string_array", "cell_ids", "metadata_field", "metadata_field_array", "string_vec_or_list", "cell_ids_or_set", "list_or_cell_set", "list"]},
        "default": {}, "required": {"type": "boolean"}, "nullable": {"type": "boolean"},
        "allow_non_finite": {"type": "boolean"}, "min": {"type": "number"}, "max": {"type": "number"},
        "choices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "help": {"type": "string", "minLength": 1}
      }
    }
  }
}
