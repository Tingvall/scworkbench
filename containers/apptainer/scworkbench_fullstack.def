Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_21

%labels
    Maintainer Dirk_de_Weerd
    Package scworkbench
    Stack full
    Runtime apptainer

%help
    Full-stack scworkbench Apptainer image.

    Includes:
    - scworkbench engine
    - scworkbenchShiny app tree
    - pybench Python runtime tree
    - R/Bioconductor method stack used by current ops
    - Python analysis stack for scanpy/palantir/scvi/PeakVI CUDA-capable workloads

    Build from the scworkbench repo root so the %files paths resolve:
      apptainer build --fakeroot scworkbench_fullstack.sif containers/apptainer/scworkbench_fullstack.def

%files
    . /opt/scworkbench
    ../scworkbenchShiny /opt/scworkbenchShiny
    ../pybench/pyproject.toml /opt/pybench/pyproject.toml
    ../pybench/README.md /opt/pybench/README.md
    ../pybench/CITATION.cff /opt/pybench/CITATION.cff
    ../pybench/LICENSE /opt/pybench/LICENSE
    ../pybench/src /opt/pybench/src
    scripts/prepare_bpcells_python_fork.sh /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh
    third_party/patches/bpcells-python-noninteger-read.patch /opt/scworkbench/third_party/patches/bpcells-python-noninteger-read.patch
    containers/apptainer/run-scworkbench-shiny /usr/local/bin/run-scworkbench-shiny

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export RETICULATE_PYTHON=/opt/pyenv/bin/python
    export PYBENCH_MATRIX_READ_CHUNK_CELLS=1
    export PATH=/opt/pyenv/bin:/usr/local/bin:$PATH

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        git \
        curl \
        wget \
        ca-certificates \
        pkg-config \
        cmake \
        make \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgit2-dev \
        libhdf5-dev \
        libeigen3-dev \
        libhwy-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libglpk-dev \
        libgsl-dev \
        libudunits2-dev \
        libgeos-dev \
        libproj-dev \
        libgdal-dev \
        libfftw3-dev \
        libzmq3-dev \
        libxt-dev \
        libfontconfig1-dev \
        libsqlite3-dev \
        libx11-dev \
        libglu1-mesa-dev \
        libgl1-mesa-dev \
        libopenblas-dev \
        liblapack-dev \
        python3 \
        python-is-python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-setuptools \
        python3-wheel \
        openjdk-17-jdk \
        pandoc
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/pyenv
    /opt/pyenv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel pybind11 setuptools-scm
    /opt/pyenv/bin/python -m pip install --no-cache-dir numpy pandas scipy
    DEB_MULTIARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
    export CPATH=/usr/include/eigen3:/usr/include/hdf5/serial:/usr/include
    export LIBRARY_PATH=/usr/lib/${DEB_MULTIARCH}/hdf5/serial:/usr/lib/${DEB_MULTIARCH}
    export BPCELLS_NUM_BUILD_JOBS=1
    chmod +x /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh
    rm -rf /tmp/BPCells_python_fork_build
    /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh /tmp/BPCells_python_fork_build
    cp /tmp/BPCells_python_fork_build/scworkbench_bpcells_python_provenance.env /tmp/scworkbench_bpcells_python_provenance.env
    rm -rf /tmp/BPCells_python_fork_wheel
    /opt/pyenv/bin/python -m pip wheel --no-deps --wheel-dir /tmp/BPCells_python_fork_wheel /tmp/BPCells_python_fork_build/python
    BPCELLS_PYTHON_WHEEL="$(find /tmp/BPCells_python_fork_wheel -maxdepth 1 -name 'bpcells-*.whl' -print -quit)"
    test -n "${BPCELLS_PYTHON_WHEEL}"
    /opt/pyenv/bin/python -m pip install --no-cache-dir "${BPCELLS_PYTHON_WHEEL}"
    /opt/pyenv/bin/python -c 'import bpcells.experimental; print("Python BPCells fork import OK")'
    rm -rf /tmp/BPCells_python_fork_build
    /opt/pyenv/bin/python -m pip install --no-cache-dir \
        scikit-learn \
        anndata \
        scanpy \
        palantir \
        mudata \
        jupyterlab
    # Install a CUDA-capable PyTorch build. At runtime the container should be
    # launched with --nv on hosts that provide a compatible NVIDIA driver.
    /opt/pyenv/bin/python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 torch
    /opt/pyenv/bin/python -m pip install --no-cache-dir scvi-tools
    for required in pyproject.toml README.md CITATION.cff LICENSE; do
        test -f "/opt/pybench/${required}"
    done
    test -d /opt/pybench/src/pybench
    /opt/pyenv/bin/python -m pip install --no-cache-dir --no-deps /opt/pybench

    # The container only needs installable source, not the large local report payloads.
    # Keeping reports in the copied repo can push R's package tar step past the 8GB limit.
    rm -rf /opt/scworkbench/reports

    cat >/tmp/install_scworkbench_stack.R <<'EOF'
options(repos = c(CRAN = "https://cloud.r-project.org"))
options(Ncpus = max(1L, parallel::detectCores()))

install_if_missing <- function(pkgs) {
  miss <- pkgs[!vapply(pkgs, requireNamespace, logical(1), quietly = TRUE)]
  if (length(miss)) install.packages(miss)
}

install_if_missing(c("BiocManager", "remotes", "devtools"))

# R BPCells is a native dependency. Pin the source commit rather than relying
# on whichever GitHub HEAD happens to be available during an image build.
bpcells_r_ref <- "c293a0a34e653c395c8e9bf9ed3133107324d7b7"

cran_pkgs <- c(
  "DBI", "RSQLite", "jsonlite", "Seurat", "Matrix", "uwot", "igraph",
  "RANN", "ggplot2", "viridisLite", "shiny", "shinyFiles", "magrittr",
  "DT", "plotly", "visNetwork", "zip", "colourpicker"
)
install_if_missing(cran_pkgs)

if (requireNamespace("BPCells", quietly = TRUE)) {
  remove.packages("BPCells")
}
remotes::install_github(
  repo = "bnprks/BPCells",
  ref = bpcells_r_ref,
  subdir = "r",
  upgrade = "never"
)
installed_bpcells_ref <- as.character(utils::packageDescription("BPCells")$RemoteSha)
if (is.na(installed_bpcells_ref) || !nzchar(installed_bpcells_ref)) installed_bpcells_ref <- ""
if (!identical(installed_bpcells_ref, bpcells_r_ref)) {
  stop("BPCells install did not produce the pinned commit: expected ", bpcells_r_ref,
       ", got ", installed_bpcells_ref)
}

bioc_pkgs <- c(
  "BiocParallel", "S4Vectors", "IRanges", "Biostrings",
  "SummarizedExperiment", "SingleCellExperiment", "GenomicRanges",
  "GenomeInfoDb", "TFBSTools", "chromVAR", "motifmatchr", "JASPAR2020",
  "BSgenome", "BSgenome.Mmusculus.UCSC.mm10",
  "BSgenome.Hsapiens.UCSC.hg19", "slingshot", "monocle3"
)
miss_bioc <- bioc_pkgs[!vapply(bioc_pkgs, requireNamespace, logical(1), quietly = TRUE)]
if (length(miss_bioc)) {
  BiocManager::install(miss_bioc, ask = FALSE, update = FALSE)
}

if (!requireNamespace("monocle3", quietly = TRUE)) {
  remotes::install_github("cole-trapnell-lab/monocle3")
}

remotes::install_local("/opt/scworkbench", upgrade = "never", dependencies = TRUE, build = FALSE)

runtime_provenance <- c(
  paste0("built_at=", format(Sys.time(), "%Y-%m-%dT%H:%M:%S%z")),
  paste0("r_version=", getRversion()),
  paste0("bpcells_version=", as.character(utils::packageVersion("BPCells"))),
  paste0("bpcells_remote_sha=", {
    x <- as.character(utils::packageDescription("BPCells")$RemoteSha)
    if (is.na(x) || !nzchar(x)) "" else x
  }),
  paste0("rcpp_version=", as.character(utils::packageVersion("Rcpp"))),
  paste0("rhdf5_version=", if (requireNamespace("rhdf5", quietly = TRUE)) as.character(utils::packageVersion("rhdf5")) else "not_installed"),
  paste0("hdf5_system=", system("h5cc -showconfig 2>/dev/null | head -n 1", intern = TRUE))
)
python_bpcells_provenance <- readLines("/tmp/scworkbench_bpcells_python_provenance.env", warn = FALSE)
runtime_provenance <- c(runtime_provenance, python_bpcells_provenance)
writeLines(runtime_provenance, "/opt/scworkbench_runtime_provenance.txt")
EOF

    Rscript /tmp/install_scworkbench_stack.R
    rm -f /tmp/install_scworkbench_stack.R

    chmod +x /usr/local/bin/run-scworkbench-shiny

%runscript
    exec /bin/bash "$@"
