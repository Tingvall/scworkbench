Bootstrap: docker
From: bioconductor/bioconductor_docker@sha256:41ed449aa2181f330cdc8d0499a11a7435b04827ff926dc141584a34f65a12cb

%labels
    Maintainer Dirk_de_Weerd
    Package scworkbench
    Stack core
    Runtime apptainer
    ScworkbenchVersion 0.1.0
    PyBenchVersion 0.1.0
    PyBenchProtocol 2

%help
    Core scworkbench + PyBench Apptainer image.

    Includes:
    - scworkbench engine
    - pybench Python runtime tree
    - R/Bioconductor method stack used by current ops
    - Python analysis stack for scanpy/palantir/scvi/PeakVI CUDA-capable workloads

    Optional clients such as scworkbenchShiny and scwb-agent are not bundled.

    Build from the scworkbench repo root so the %files paths resolve:
      apptainer build --fakeroot scworkbench_fullstack.sif containers/apptainer/scworkbench_fullstack.def

%files
    . /opt/scworkbench
    ../pybench/pyproject.toml /opt/pybench/pyproject.toml
    ../pybench/README.md /opt/pybench/README.md
    ../pybench/CITATION.cff /opt/pybench/CITATION.cff
    ../pybench/LICENSE /opt/pybench/LICENSE
    ../pybench/CHANGELOG.md /opt/pybench/CHANGELOG.md
    ../pybench/src /opt/pybench/src
    ../pybench/protocol /opt/pybench/protocol
    scripts/prepare_bpcells_python_fork.sh /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh
    third_party/patches/bpcells-python-noninteger-read.patch /opt/scworkbench/third_party/patches/bpcells-python-noninteger-read.patch

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export RETICULATE_PYTHON=/opt/pyenv/bin/python
    export PYBENCH_MATRIX_READ_CHUNK_CELLS=1
    export PATH=/opt/pyenv/bin:/usr/local/bin:$PATH

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export SCWORKBENCH_RUNTIME_KIND="${SCWORKBENCH_RUNTIME_KIND:-apptainer}"
    export SCWORKBENCH_RUNTIME_ARCH="${SCWORKBENCH_RUNTIME_ARCH:-amd64}"
    export SCWORKBENCH_BASE_IMAGE_DIGEST="${SCWORKBENCH_BASE_IMAGE_DIGEST:-sha256:41ed449aa2181f330cdc8d0499a11a7435b04827ff926dc141584a34f65a12cb}"

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        git \
        curl \
        wget \
        ca-certificates \
        pkg-config \
        cmake \
        make \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgit2-dev \
        libhdf5-dev \
        libeigen3-dev \
        libhwy-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libglpk-dev \
        libgsl-dev \
        libudunits2-dev \
        libgeos-dev \
        libproj-dev \
        libgdal-dev \
        libfftw3-dev \
        libzmq3-dev \
        libxt-dev \
        libfontconfig1-dev \
        libsqlite3-dev \
        libx11-dev \
        libglu1-mesa-dev \
        libgl1-mesa-dev \
        libopenblas-dev \
        liblapack-dev \
        python3 \
        python-is-python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-setuptools \
        python3-wheel \
        openjdk-17-jdk \
        pandoc
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/pyenv
    /opt/pyenv/bin/python -m pip install --no-cache-dir \
        pip==26.2 setuptools==83.0.0 wheel==0.47.0 pybind11==3.0.4 setuptools-scm==10.2.1
    /opt/pyenv/bin/python -m pip install --no-cache-dir \
        -r /opt/scworkbench/containers/apptainer/fullstack_python_requirements.lock
    DEB_MULTIARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
    export CPATH=/usr/include/eigen3:/usr/include/hdf5/serial:/usr/include
    export LIBRARY_PATH=/usr/lib/${DEB_MULTIARCH}/hdf5/serial:/usr/lib/${DEB_MULTIARCH}
    export BPCELLS_NUM_BUILD_JOBS=1
    chmod +x /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh
    rm -rf /tmp/BPCells_python_fork_build
    /opt/scworkbench/scripts/prepare_bpcells_python_fork.sh /tmp/BPCells_python_fork_build
    cp /tmp/BPCells_python_fork_build/scworkbench_bpcells_python_provenance.env /tmp/scworkbench_bpcells_python_provenance.env
    rm -rf /tmp/BPCells_python_fork_wheel
    /opt/pyenv/bin/python -m pip wheel --no-deps --wheel-dir /tmp/BPCells_python_fork_wheel /tmp/BPCells_python_fork_build/python
    BPCELLS_PYTHON_WHEEL="$(find /tmp/BPCells_python_fork_wheel -maxdepth 1 -name 'bpcells-*.whl' -print -quit)"
    test -n "${BPCELLS_PYTHON_WHEEL}"
    /opt/pyenv/bin/python -m pip install --no-cache-dir "${BPCELLS_PYTHON_WHEEL}"
    /opt/pyenv/bin/python -c 'import bpcells.experimental; print("Python BPCells fork import OK")'
    rm -rf /tmp/BPCells_python_fork_build
    for required in pyproject.toml README.md CITATION.cff LICENSE CHANGELOG.md; do
        test -f "/opt/pybench/${required}"
    done
    test -d /opt/pybench/src/pybench
    test -f /opt/pybench/protocol/pybench-op-v2.schema.json
    /opt/pyenv/bin/python -m pip install --no-cache-dir --no-deps /opt/pybench

    # The container only needs installable source, not the large local report payloads.
    # Keeping reports in the copied repo can push R's package tar step past the 8GB limit.
    rm -rf /opt/scworkbench/reports

    cat >/tmp/install_scworkbench_stack.R <<'EOF'
build_ncpus <- suppressWarnings(as.integer(Sys.getenv("SCWORKBENCH_BUILD_NCPUS", "")))
if (is.na(build_ncpus) || build_ncpus < 1L) {
  build_ncpus <- max(1L, parallel::detectCores())
}
options(Ncpus = build_ncpus)

options(repos = c(CRAN = "https://cloud.r-project.org"))

bootstrap_cran <- c("BiocManager", "remotes", "devtools")
for (package in bootstrap_cran) {
  if (!package %in% rownames(installed.packages())) {
    utils::install.packages(package, dependencies = NA)
  }
}
missing_bootstrap <- bootstrap_cran[!bootstrap_cran %in% rownames(installed.packages())]
if (length(missing_bootstrap)) stop("Missing bootstrap package(s): ", paste(missing_bootstrap, collapse = ", "))

lock_path <- "/opt/scworkbench/containers/apptainer/fullstack_r_dependencies.dcf"
source("/opt/scworkbench/inst/ci/fullstack_r_dependency_lock.R")
lock <- read_fullstack_r_dependency_lock(lock_path)
version_lock <- fullstack_read_version_lock(lock, lock_path)
configure_fullstack_repositories(lock)
is_installed <- function(package) package %in% rownames(installed.packages())
fullstack_validate_monocle3_closure(
  lock,
  "/opt/scworkbench/inst/ci/monocle3_4f4239a_dependency_snapshot.dcf"
)

# Pinned GitHub-managed packages. Release images must not depend on a moving
# GitHub branch tip.
bpcells_r_ref <- lock$GitHubBPCellsRef
monocle3_ref <- lock$GitHubMonocle3Ref

# CRAN-managed packages. This includes declared Suggests and runtime support
# packages needed by the declared R method stack.
cran_pkgs <- version_lock$package[version_lock$source_class == "CRAN"]
cran_versions <- stats::setNames(version_lock$version[match(cran_pkgs, version_lock$package)], cran_pkgs)
source("/opt/scworkbench/inst/ci/provision_cran_namespaces.R")
cran_initial <- provision_cran_namespaces(
  cran_pkgs,
  repo = getOption("repos")[["CRAN"]],
  target_versions = cran_versions,
  allow_deferred = TRUE
)

install_pinned_github_prerequisites <- function(records, retries = 3L) {
  for (package in names(records)) {
    record <- records[[package]]
    parts <- strsplit(record, "@", fixed = TRUE)[[1L]]
    repo <- parts[[1L]]
    ref <- parts[[2L]]
    installed_ref <- if (is_installed(package)) as.character(utils::packageDescription(package)$RemoteSha) else ""
    if (!is.na(installed_ref) && identical(installed_ref, ref)) next
    if (is_installed(package)) remove.packages(package)
    install_error <- NULL
    for (attempt in seq_len(retries)) {
      install_error <- tryCatch({
        remotes::install_github(repo = repo, ref = ref, upgrade = "never", dependencies = FALSE)
        NULL
      }, error = function(error) conditionMessage(error))
      installed_ref <- if (is_installed(package)) as.character(utils::packageDescription(package)$RemoteSha) else ""
      if (!is.na(installed_ref) && identical(installed_ref, ref)) break
      if (attempt < retries) Sys.sleep(min(2^(attempt - 1L), 8L))
    }
    if (is.na(installed_ref) || !identical(installed_ref, ref)) {
      stop("Pinned monocle3 prerequisite installation failed: package=", package,
           "; repo=", repo, "; ref=", ref, "; retries=", retries,
           "; install_error=", ifelse(is.null(install_error), "<none>", install_error))
    }
    cat("Pinned monocle3 prerequisite installed: ", package, " repo=", repo, " ref=", ref, "\n", sep = "")
  }
}
install_pinned_github_prerequisites(lock$GitHubMonocle3GitHubPrerequisites)

bpcells_prereqs <- c("progress", "tzdb", "hms", "vroom", "hexbin", "readr")
missing_bpcells_prereqs <- bpcells_prereqs[!vapply(bpcells_prereqs, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing_bpcells_prereqs)) stop("BPCells CRAN prerequisites missing after locked provisioning: ", paste(missing_bpcells_prereqs, collapse=", "))

if (is_installed("BPCells")) {
  remove.packages("BPCells")
}
remotes::install_github(
  repo = lock$GitHubBPCellsRepo,
  ref = bpcells_r_ref,
  subdir = lock$GitHubBPCellsSubdir,
  upgrade = "never",
  dependencies = FALSE
)
if (!is_installed("BPCells")) stop("Pinned BPCells installation failed after verified CRAN prerequisites.")
installed_bpcells_ref <- as.character(utils::packageDescription("BPCells")$RemoteSha)
if (is.na(installed_bpcells_ref) || !nzchar(installed_bpcells_ref)) installed_bpcells_ref <- ""
if (!identical(installed_bpcells_ref, bpcells_r_ref)) {
  stop("BPCells install did not produce the pinned commit: expected ", bpcells_r_ref,
       ", got ", installed_bpcells_ref)
}

# Bioconductor release-managed declared Suggests and their direct genomic
# support packages. Do not add GitHub-only packages to this list.
bioc_support_pkgs <- unique(c(
  lock$BioconductorPackages,
  lock$GitHubMonocle3BioconductorPrerequisites,
  version_lock$package[version_lock$source_class == "Bioconductor release"]
))
for (package in bioc_support_pkgs) {
  if (is_installed(package)) next
  install_error <- NULL
  for (attempt in seq_len(3L)) {
    install_error <- tryCatch({
      BiocManager::install(package, ask = FALSE, update = FALSE, force = TRUE, dependencies = NA)
      NULL
    }, error = function(error) conditionMessage(error))
    if (is_installed(package)) break
    if (attempt < 3L) Sys.sleep(min(2^(attempt - 1L), 8L))
  }
  if (!is_installed(package)) {
    stop("Bioconductor prerequisite installation failed: package=", package,
         "; release=", lock$BioconductorRelease, "; retries=3; install_error=",
         ifelse(is.null(install_error), "<none>", install_error))
  }
}

# Some CRAN packages (for example restfulr) depend on Bioconductor S4
# packages. The first CRAN pass installed every resolvable locked package and
# retained only those cross-repository leaves; finish them after the locked
# Bioconductor layer is available.
if (length(cran_initial$pending)) {
  provision_cran_namespaces(
    cran_initial$pending,
    repo = getOption("repos")[["CRAN"]],
    target_versions = cran_versions[cran_initial$pending]
  )
}

monocle3_prereqs <- fullstack_monocle3_closure_packages(lock)
missing_monocle3_prereqs <- monocle3_prereqs[!vapply(monocle3_prereqs, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing_monocle3_prereqs)) {
  stop("Pinned monocle3 prerequisites missing after locked provisioning: ",
       paste(missing_monocle3_prereqs, collapse = ", "))
}

installed_monocle3_ref <- if (is_installed("monocle3")) {
  as.character(utils::packageDescription("monocle3")$RemoteSha)
} else {
  ""
}
if (is.na(installed_monocle3_ref) || !identical(installed_monocle3_ref, monocle3_ref)) {
  if (is_installed("monocle3")) remove.packages("monocle3")
  remotes::install_github(
    repo = lock$GitHubMonocle3Repo,
    ref = monocle3_ref,
    upgrade = "never",
    dependencies = FALSE
  )
  if (!is_installed("monocle3")) stop("Pinned monocle3 installation failed after locked CRAN/Bioconductor prerequisites.")
  installed_monocle3_ref <- as.character(utils::packageDescription("monocle3")$RemoteSha)
}
if (is.na(installed_monocle3_ref) || !identical(installed_monocle3_ref, monocle3_ref)) {
  stop("monocle3 install did not produce the pinned commit: expected ", monocle3_ref,
       ", got ", installed_monocle3_ref)
}

remotes::install_local("/opt/scworkbench", upgrade = "never", dependencies = FALSE, build = FALSE)

# Reconcile the explicit Bioconductor genomic family after all release and
# GitHub package installation. Never recursively reinstall arbitrary reverse
# dependencies through BiocManager: GitHub-only packages are not release
# managed. Development GenomicRanges depends on standalone Seqinfo, while
# release GenomeInfoDb owns the Seqinfo S4 API.
seqinfo_release_family <- lock$BioconductorGenomicFamily
BiocManager::install(seqinfo_release_family, ask = FALSE, update = FALSE, force = TRUE, dependencies = NA)
if (is_installed("Seqinfo")) {
  remaining_dependents <- tools::package_dependencies(
    "Seqinfo",
    db = installed.packages(),
    reverse = TRUE,
    recursive = FALSE
  )[["Seqinfo"]]
  if (length(remaining_dependents)) {
    stop(
      "Cannot remove standalone Seqinfo; release reconciliation left direct dependents: ",
      paste(remaining_dependents, collapse = ", ")
    )
  }
  remove.packages("Seqinfo")
}

fullstack_assert_locked_versions(lock, lock_path)

source_class <- fullstack_source_classes(lock, "/opt/scworkbench/DESCRIPTION")
source_ref <- fullstack_source_refs(lock, source_class)
product_packages <- names(source_class)
source_manifest <- data.frame(
  package = product_packages,
  source_class = unname(source_class[product_packages]),
  source_ref = unname(source_ref[product_packages]),
  version = vapply(product_packages, function(package) {
    as.character(utils::packageVersion(package))
  }, character(1)),
  stringsAsFactors = FALSE
)
write.csv(source_manifest, "/opt/scworkbench_package_sources.csv", row.names = FALSE, quote = TRUE)

runtime_provenance <- c(
  paste0("built_at=", format(Sys.time(), "%Y-%m-%dT%H:%M:%S%z")),
  paste0("runtime_kind=", Sys.getenv("SCWORKBENCH_RUNTIME_KIND")),
  paste0("runtime_arch=", Sys.getenv("SCWORKBENCH_RUNTIME_ARCH")),
  paste0("base_image_digest=", Sys.getenv("SCWORKBENCH_BASE_IMAGE_DIGEST")),
  paste0("r_version=", getRversion()),
  paste0("bpcells_version=", as.character(utils::packageVersion("BPCells"))),
  paste0("bpcells_remote_sha=", {
    x <- as.character(utils::packageDescription("BPCells")$RemoteSha)
    if (is.na(x) || !nzchar(x)) "" else x
  }),
  paste0("rcpp_version=", as.character(utils::packageVersion("Rcpp"))),
  paste0("rhdf5_version=", if (is_installed("rhdf5")) as.character(utils::packageVersion("rhdf5")) else "not_installed"),
  paste0("hdf5_system=", system("h5cc -showconfig 2>/dev/null | head -n 1", intern = TRUE)),
  paste0("bioconductor_version=", BiocManager::version()),
  paste0("github_bpcells_ref=", bpcells_r_ref),
  paste0("github_monocle3_ref=", monocle3_ref),
  paste0("scworkbench_version=", as.character(utils::packageVersion("scworkbench"))),
  paste0("pybench_version=", system("/opt/pyenv/bin/python -c 'import importlib.metadata as m; print(m.version(\"pybench\"))'", intern = TRUE)),
  "pybench_protocol_version=2",
  "pybench_protocol_sha256=d5e80b58e4f18b37d0e906e7dac127fd17fbb88ea56dd83926406691303b655b",
  paste0("r_version_lock_sha256=", system("sha256sum /opt/scworkbench/containers/apptainer/fullstack_r_versions.lock.csv | awk '{print $1}'", intern = TRUE)),
  paste0("python_version_lock_sha256=", system("sha256sum /opt/scworkbench/containers/apptainer/fullstack_python_requirements.lock | awk '{print $1}'", intern = TRUE)),
  "package_source_manifest=/opt/scworkbench_package_sources.csv",
  "package_validation_manifest=/opt/scworkbench_package_validation.csv"
)
python_bpcells_provenance <- readLines("/tmp/scworkbench_bpcells_python_provenance.env", warn = FALSE)
runtime_provenance <- c(runtime_provenance, python_bpcells_provenance)
writeLines(runtime_provenance, "/opt/scworkbench_runtime_provenance.txt")
EOF

    Rscript /tmp/install_scworkbench_stack.R
    rm -f /tmp/install_scworkbench_stack.R
    Rscript /opt/scworkbench/inst/ci/validate_fullstack_r_dependencies.R \
      --lock /opt/scworkbench/containers/apptainer/fullstack_r_dependencies.dcf \
      --description /opt/scworkbench/DESCRIPTION \
      --manifest /opt/scworkbench_package_validation.csv
    /opt/pyenv/bin/python /opt/scworkbench/inst/ci/validate_fullstack_python_lock.py \
      --requirements /opt/scworkbench/containers/apptainer/fullstack_python_requirements.lock \
      --pybench /opt/pybench/pyproject.toml
    Rscript /opt/scworkbench/inst/ci/check_declared_suggests.R \
      --description /opt/scworkbench/DESCRIPTION \
      --manifest /opt/scworkbench_declared_suggests.csv
    Rscript /opt/scworkbench/inst/ci/check_genomicranges_runtime.R

%runscript
    exec /bin/bash "$@"
