{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbv3phase5",
  "package": {"name": "scwbV3Phase5", "version": "0.1.0"},
  "backend": "R",
  "compatibility": {
    "scworkbench": {"minimum": "0.1.0", "maximum_exclusive": "0.2.0"},
    "pack_abi": {"minimum": "3", "maximum": "3"}
  },
  "entry_point": "scwbV3Phase5::register_operation_pack",
  "operations": [
    {
      "name": "fit_sibling_model",
      "qualified_name": "scwbv3phase5::fit_sibling_model",
      "title": "Sibling model fixture",
      "description": "Publishes a contained model with a terminal sibling and no paired two-dimensional output.",
      "runner": ".fit_sibling_model",
      "inputs": [
        {"name": "source", "kind": "space", "required": true, "alignment": "cell_ordered"}
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "dims": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "uniqueItems": true}
        },
        "required": ["dims"],
        "additionalProperties": false
      },
      "dimension_policies": [
        {
          "output": "embedding",
          "policy": "authenticated_output_axes_v1",
          "shape": "one_per_cell",
          "cell_axis": {"source": "effective_cells_v1", "input": "source"},
          "row_order": "input_cell_order_v1",
          "missing_values": "forbidden"
        }
      ],
      "outputs": [
        {
          "name": "model",
          "category": "terminal_artifact",
          "kind": "model_ref",
          "storage_profile": "model_ref_contained_tree_v1",
          "allocated_id_key": "model_id",
          "required": true,
          "promotion_group": "fit",
          "contained_model_sibling_closure_policy": {
            "policy": "staged_contained_model_sibling_closure_v1",
            "engine": "fixture",
            "model_type": "phase5_model",
            "primary_path": "model.bin",
            "source_space_input": "source",
            "dimensions_parameter": "dims",
            "required_sibling_terminals": ["embedding"],
            "file_order": "utf8_path_lexicographic_v1",
            "maximum_file_count": 32,
            "maximum_total_bytes": 1073741824
          }
        },
        {
          "name": "embedding",
          "category": "terminal_artifact",
          "kind": "cell_vector",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "embedding_id",
          "required": true,
          "promotion_group": "fit",
          "value_kind": "continuous"
        }
      ],
      "dependencies": [],
      "promotion_closure": {"model": ["embedding", "model"], "embedding": ["embedding", "model"]},
      "replay_equivalence": {"model": "loadable_reference", "embedding": "exact_canonical_value"}
    },
    {
      "name": "consume_self_linked_model",
      "qualified_name": "scwbv3phase5::consume_self_linked_model",
      "title": "Self-linked model fixture",
      "description": "Consumes a durable model by its own authenticated source linkage.",
      "runner": ".consume_self_linked_model",
      "inputs": [
        {"name": "model", "kind": "model_ref", "required": true, "alignment": "model_linked"}
      ],
      "params_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "self_linked_contained_model_reads": [
        {
          "name": "fitted_model",
          "input": "model",
          "reader": "read_self_linked_contained_model_payload",
          "allowed_models": [{"engine": "fixture", "model_type": "phase5_model"}],
          "linkage_policy": "authenticated_existing_source_and_cell_linkage_v1",
          "maximum_file_count": 32,
          "maximum_total_bytes": 1073741824,
          "call_discipline": "exactly_once"
        }
      ],
      "dimension_policies": [{"output": "summary", "policy": "data_dependent_table_v1"}],
      "outputs": [
        {
          "name": "summary",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "summary_id",
          "required": true,
          "promotion_group": "summary",
          "table_type": "phase5_model_summary"
        }
      ],
      "dependencies": [],
      "promotion_closure": {"summary": ["summary"]},
      "replay_equivalence": {"summary": "exact_canonical_value"}
    }
  ]
}
