+enum class MatrixValueType {
+    UInt32,
+    Float32,
+    Float64,
+};
+
+static MatrixValueType matrix_value_type(std::string matrix_path) {
+    FileReaderBuilder rb(matrix_path);
+    const std::string version = rb.readVersion();
+
+    if (version.rfind("packed-uint-matrix-", 0) == 0 || version.rfind("unpacked-uint-matrix-", 0) == 0) {
+        return MatrixValueType::UInt32;
+    }
+    if (version.rfind("packed-float-matrix-", 0) == 0 || version.rfind("unpacked-float-matrix-", 0) == 0) {
+        return MatrixValueType::Float32;
+    }
+    if (version.rfind("packed-double-matrix-", 0) == 0 || version.rfind("unpacked-double-matrix-", 0) == 0) {
+        return MatrixValueType::Float64;
+    }
+
+    throw std::runtime_error("Unsupported BPCells matrix version: " + version);
+}
