      "outputs": [{"name": "space", "category": "materialization", "kind": "space", "allocated_id": "space_pca", "storage_profile": "space_file_backed_hdf5_v1", "status": "staged", "content_identity": {"scheme": "scworkbench.space.v1", "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}, "dimensions": [100, 20], "cell_order_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "ancestry_sha256": "1111111111111111111111111111111111111111111111111111111111111111", "payload_manifest_sha256": "2222222222222222222222222222222222222222222222222222222222222222", "semantic_metadata_sha256": "3333333333333333333333333333333333333333333333333333333333333333"}],
      "registry_requests": [], "mutation_manifest": {"entries_sha256": "4444444444444444444444444444444444444444444444444444444444444444", "entry_count": 1, "unexpected_entries": 0}, "runtime_attestation": {"schema": "scworkbench.operation_pack.runtime.v2", "backend": "R", "runtime_sha256": "5555555555555555555555555555555555555555555555555555555555555555", "pack_content_sha256": "6666666666666666666666666666666666666666666666666666666666666666", "operation_definition_sha256": "7777777777777777777777777777777777777777777777777777777777777777", "distribution_sha256": "8888888888888888888888888888888888888888888888888888888888888888", "manifest_source_sha256": "9999999999999999999999999999999999999999999999999999999999999999", "entry_point": "scwbRepresentation::.run_pca_fit", "dependency_set_sha256": "1212121212121212121212121212121212121212121212121212121212121212"}, "receipt_identity": {"scheme": "scworkbench.operation_pack.transition_receipt.v2", "scope": "receipt excluding receipt_identity", "sha256": "1313131313131313131313131313131313131313131313131313131313131313"}
