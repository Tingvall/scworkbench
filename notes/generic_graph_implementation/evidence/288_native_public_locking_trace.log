 if (is.data.frame(registry_events) && nrow(registry_events) &&              any(as.character(registry_events$registry_type) ==                  "operation_pack_cell_set_family")) {             .wb_operation_pack_registry_fault("after_sqlite_writes_before_commit",                  commit_id = commit_id)         }     }     artifact_pool <- list()     promoted_by_run <- list()     rows <- list()     row_i <- 0L     for (rid in topo) {         run <- runs[[rid]]         op <- .wb_get_op(run$op_name)         desired <- if (!is.null(selected_by_run))              selected_by_run[[rid]] %||% character(0)         else selected_outputs         promotable <- if (rid %in% heads)              intersect(op$promotable %||% character(0), desired)         else character(0)         promoted_ids <- list()         err <- NULL         parent_artifacts <- list()         for (parent_run_id in unique(as.character(run$inputs$parents %||%              character(0)))) {             parent_artifacts <- c(parent_artifacts, promoted_by_run[[parent_run_id]] %||%                  list())         }         tryCatch({             for (out_name in promotable) {                 if (!out_name %in% names(run$outputs))                    next                 prim <- run$outputs[[out_name]]                 .wb_assert(.wb_is_primitive(prim), paste0("Run output '",                    out_name, "' is not a wb_primitive (kind missing)."))                 nm <- .wb_default_artifact_name(run = run, out_name = out_name,                    prim = prim, name_prefix = name_prefix)                 promoter <- .wb_get_promoter_for_kind(prim$kind)                 promoter_args <- list(bundle = bundle, run = run,                    out_name = out_name, prim = prim, name = nm,                    description = description, created_by = created_by,                    parent_artifacts = parent_artifacts, workspace = workspace)                 if (identical(as.character(prim$kind)[1L], "relation_family")) {                   promoter_args$sealed_content_identity <- !is.null(staging_bundle) &&                      .wb_operation_pack_v3_rf_promotion_sealed(staging_bundle,                        run, out_name)                 }                 artifact_id <- do.call(promoter, promoter_args)                 if (!length(promoted_ids))                    .wb_promotion_transaction_fault("after_first_private_terminal_write",                      commit_id = commit_id, artifact_id = artifact_id,                      output = out_name)                 if (identical(as.character(prim$kind)[1], "relation_family") &&                    !is.null(staging_bundle)) {                   .wb_operation_pack_v2_fault("relation_family_promoted",                      output = out_name, artifact_id = artifact_id)                   .wb_operation_pack_v3_rf_promoted_assert(bundle,                      staging_bundle, run, out_name, artifact_id)                 }                 promoted_ids[[out_name]] <- artifact_id             }         }, error = function(e) {             err <<- conditionMessage(e)             if (isTRUE(fail_fast))                  stop(e)         })         if (length(promoted_ids)) {             for (k in names(promoted_ids)) {                 if (is.null(artifact_pool[[k]]) || !nzchar(artifact_pool[[k]])) {                   artifact_pool[[k]] <- promoted_ids[[k]]                 }             }             promoted_by_run[[rid]] <- promoted_ids             for (out_name in names(promoted_ids)) {                 row_i <- row_i + 1L                 rows[[row_i]] <- data.frame(run_id = run$run_id,                    op_name = run$op_name, output = out_name, artifact_id = as.character(promoted_ids[[out_name]]),                    status = "ok", error = NA_character_, stringsAsFactors = FALSE)             }         }         else {             row_i <- row_i + 1L             rows[[row_i]] <- data.frame(run_id = run$run_id,                  op_name = run$op_name, output = "", artifact_id = NA_character_,                  status = if (is.null(err))                    "skipped"                 else "error", error = if (is.null(err))                    NA_character_                 else err, stringsAsFactors = FALSE)         }     }     promoted_df <- do.call(rbind, rows)     snapshot_id <- .wb_prov_write_snapshot(bundle = bundle, runs = runs,          topo = topo, heads = heads, promoted_df = promoted_df,          name_prefix = name_prefix, description = description,          created_by = created_by, commit_id = commit_id, materializations = materializations,          runtime_fingerprint = runtime_fingerprint, workspace = workspace,          staging_bundle = staging_bundle, transaction_open = TRUE)     DBI::dbExecute(bundle$con, "UPDATE prov_commits SET state = ? WHERE commit_id = ?;",          params = list("complete", commit_id))     promoted_df$snapshot_id <- snapshot_id     lineage_df <- .wb_artifact_lineage_statuses(bundle, promoted_df = promoted_df,          snapshot_id = snapshot_id)     .wb_artifacts_apply_lineage_status(bundle, lineage_df = lineage_df,          snapshot_id = snapshot_id)     if (nrow(lineage_df)) {         promoted_df$..row_ix_tmp <- seq_len(nrow(promoted_df))         promoted_df <- merge(promoted_df, lineage_df, by = "artifact_id",              all.x = TRUE, sort = FALSE)         promoted_df <- promoted_df[order(promoted_df$..row_ix_tmp),              , drop = FALSE]         promoted_df$..row_ix_tmp <- NULL         rownames(promoted_df) <- NULL     }     if (!isTRUE(allow_detached)) {         bad <- promoted_df[as.character(promoted_df$status %||%              "") == "ok" & as.character(promoted_df$lineage_status %||%              "") == "detached", , drop = FALSE]         if (nrow(bad)) {             labs <- paste0(as.character(bad$artifact_id), " (run=",                  as.character(bad$run_id %||% ""), ", output=",                  as.character(bad$output %||% ""), ")")             stop("Promotion blocked: detached artifact lineage detected for ",                  nrow(bad), " artifact(s): ", paste(utils::head(labs,                    10L), collapse = "; "), if (nrow(bad) > 10L)                    " ..."                 else "", ". This indicates unreconstructable lineage. Set allow_detached=TRUE only for expert/dev debugging.",                  call. = FALSE)         }     }     atomic_verification <- NULL     if (!is.null(target_reproduction_receipts)) {         atomic_verification <- .wb_target_reproduction_receipts_persist(bundle = bundle,              receipts = target_reproduction_receipts, promoted_df = promoted_df,              snapshot_id = snapshot_id)     }     .wb_promotion_workspace_publish(workspace)     .wb_promotion_transaction_fault("after_payload_move_before_database_commit",          commit_id = commit_id, workspace = workspace)     if (!is.null(target_reproduction_receipts)) {         .wb_target_reproduction_atomicity_hook("after_receipt_insertions_before_sqlite_commit",              snapshot_id = snapshot_id, workspace = workspace)     }     DBI::dbCommit(bundle$con)     transaction_open <- FALSE     .wb_promotion_workspace_retire(workspace)     if (dir.exists(workspace$pending_root))          unlink(workspace$pending_root, recursive = TRUE, force = TRUE)     .wb_refresh_manifest_committed(bundle)     list(artifact_pool = artifact_pool, promoted = promoted_df,          provenance_snapshot_id = snapshot_id, target_reproduction_verification = atomic_verification) }, error = function(e) {     promotion_error <<- e     stop(e) }) 
