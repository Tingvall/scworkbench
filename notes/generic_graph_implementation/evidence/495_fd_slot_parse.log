        params = list(), outputs = list(result = graph))
    counts <- function() vapply(c("artifacts", "artifact_graph_meta", 
        "artifact_graph_rows", "prov_commits", "prov_runs", "prov_run_outputs", 
        "prov_run_entity_bindings"), function(table) as.numeric(DBI::dbGetQuery(bundle$con, 
        paste0("SELECT COUNT(*) n FROM ", table))$n[[1L]]), numeric(1))
    before <- counts()
    restore_budget <- scworkbench:::.wb_graph_aggregate_connection_budget(list(bundle$con, 
        stage$con), stage$budgets)
    on.exit(restore_budget(), add = TRUE)
    stage$budgets$published_bytes <- "1"
    bad <- tryCatch(DBI::dbWithTransaction(bundle$con, scworkbench:::.wb_promote_graph(bundle, 
        run, "result", graph)), error = identity)
    stopifnot(inherits(bad, "wb_graph_error"), bad$code == "GRAPH_RESOURCE_EXCEEDED", 
        identical(counts(), before))
    stage$budgets$published_bytes <- "1048576"
    id <- DBI::dbWithTransaction(bundle$con, scworkbench:::.wb_promote_graph(bundle, 
        run, "result", graph))
    stopifnot(length(id) == 1L, counts()[["artifacts"]] == 1L)
    TRUE
}, test_graph_resource_padded_mapping_cursor_contract <- function() {
    id <- function(scheme) list(scheme = scheme, sha256 = paste(rep("1", 
        64L), collapse = ""))
    binding <- list(binding_id = "view", axis_kind = "cell", 
        source_ref = list(kind = "retained_cell_axis", source_id = "synthetic"), 
        source_snapshot_identity = id("scworkbench.provenance.snapshot_head.v1"), 
        axis_content_identity = id("scworkbench.graph.source-axis-content.canonical-json.v1"), 
        axis_order_identity = id("scworkbench.cell_order.v1"), 
        mapping = list(list(node_id = "n2", axis_id = "c2"), 
            list(node_id = "n1", axis_id = "c1")))
    graph <- wb_prim_graph(list(list(node_id = "n2"), list(node_id = "n1")), 
        list(), list(), associations = list(binding))
    stage <- scworkbench:::.wb_graph_stage_small(graph, list(partition_bytes = 2048))
    on.exit(scworkbench:::.wb_graph_stage_discard(stage), add = TRUE)
    rows <- DBI::dbGetQuery(stage$con, "SELECT row_ordinal,record_json FROM artifact_graph_rows WHERE component='binding_mappings';")
    for (i in seq_len(nrow(rows))) DBI::dbExecute(stage$con, 
        "UPDATE artifact_graph_rows SET record_json=? WHERE component='binding_mappings' AND row_ordinal=?;", 
        params = list(paste0(rows$record_json[[i]], paste(rep(" ", 
            1800L), collapse = "")), rows$row_ordinal[[i]]))
    batches <- 0L
    old <- options(scworkbench.graph_storage_test_hook = function(event, 
        evidence) {
        if (event == "binding_mapping_batch") {
            stopifnot(evidence$rows == 1L, evidence$encoded_bytes <= 
                2048)
            batches <<- batches + 1L
        }
    })
    on.exit(options(old), add = TRUE)
    stopifnot(identical(scworkbench:::.wb_graph_sql_identities(stage$con, 
        "staged", stage$budgets)$descriptor_identity, wb_graph_identity(graph)$descriptor_identity), 
        batches == 2L)
    TRUE
}, test_graph_resource_import_connection_reservation_contract <- function() {
    graph <- wb_prim_graph(nodes = list(list(node_id = "n1")), 
        edges = list(), incidences = list())
    policy <- scworkbench:::.wb_graph_budgets(list(memory_bytes = "1048576", 
        sqlite_cache_kib = 256L, partition_bytes = 4096L, partition_rows = 2L, 
        collect_bytes = 8192L))
    seed <- scworkbench:::.wb_graph_stage_small(graph)
    token <- tempfile("graph_import_reservation_")
    source <- DBI::dbConnect(RSQLite::SQLite(), ":memory:")
    durable <- DBI::dbConnect(RSQLite::SQLite(), ":memory:")
    connections <- list(source, durable)
    stages <- list()
    restore <- NULL
    old <- options("scworkbench.graph_storage_test_hook")
    on.exit({
        options(old)
        for (stage in stages) scworkbench:::.wb_graph_stage_discard(stage)
        scworkbench:::.wb_graph_stage_discard(seed)
        if (!is.null(restore)) restore()
        DBI::dbDisconnect(source)
        DBI::dbDisconnect(durable)
        unlink(token)
    }, add = TRUE)
    snapshot <- function(con) list(cache = DBI::dbGetQuery(con, 
        "PRAGMA cache_size;")[[1L]][[1L]], temp = DBI::dbGetQuery(con, 
        "PRAGMA temp_store;")[[1L]][[1L]], policy = con@ref$wb_graph_policy, 
        cap = con@ref$wb_graph_cache_kib)
    before <- lapply(connections, snapshot)
    scworkbench:::.wb_graph_export_parts(seed$con, "staged", 
        token, policy)
    restore <- scworkbench:::.wb_graph_aggregate_connection_budget(connections, 
        policy, extra = 2L)
    observed <- numeric()
    options(scworkbench.graph_storage_test_hook = function(event, 
        state) if (event == "configured") {
        all <- c(connections, lapply(stages, function(stage) stage$con), 
            list(state$con))
        reservation <- 128 + sum(vapply(all, function(con) -DBI::dbGetQuery(con, 
            "PRAGMA cache_size;")[[1L]][[1L]], numeric(1)))
        stopifnot(reservation <= 256L)
        observed <<- c(observed, reservation)
    })
    stages[[1L]] <- scworkbench:::.wb_graph_import_parts(token, 
        policy, connections = connections, cache_slots = 2L)
    stages[[2L]] <- scworkbench:::.wb_graph_import_parts(token, 
        policy, connections = c(connections, list(stages[[1L]]$con)), 
        cache_slots = 1L)
    stopifnot(identical(observed, c(224, 256)))
    for (stage in stages) scworkbench:::.wb_graph_stage_discard(stage)
    stages <- list()
    restore()
    restore <- NULL
    stopifnot(identical(before, lapply(connections, snapshot)))
    paths <- character()
    options(scworkbench.graph_storage_test_hook = function(event, 
        state) {
        if (event == "connected") 
            paths <<- c(paths, state$path)
        if (event == "configured") 
            stop("import-configured-fault")
    })
    failed <- tryCatch(scworkbench:::.wb_graph_import_parts(token, 
        policy, connections = connections), error = identity)
    stopifnot(inherits(failed, "error"), grepl("import-configured-fault", 
        conditionMessage(failed)), !any(file.exists(paths)), 
        identical(before, lapply(connections, snapshot)), scworkbench:::.wb_graph_budgets()$sqlite_cache_kib == 
            8192L)
    options(scworkbench.graph_storage_test_hook = NULL)
    too_small <- policy
    too_small$sqlite_cache_kib <- 128L
    failed <- tryCatch(scworkbench:::.wb_graph_import_parts(token, 
        too_small, connections = connections), error = identity)
    stopifnot(inherits(failed, "wb_graph_error"), failed$code == 
        "GRAPH_RESOURCE_EXCEEDED", identical(before, lapply(connections, 
        snapshot)))
    TRUE
}, test_graph_resource_unrelated_descriptor_slot_contract <- function() {
    policy <- scworkbench:::.wb_graph_budgets(list(memory_bytes = "1048576", 
        sqlite_cache_kib = 256L, partition_bytes = 4096L, partition_rows = 2L, 
        collect_bytes = 8192L))
    root <- tempfile("graph_fd_live_slots_")
    dir.create(root)
    paths <- file.path(root, paste0(sprintf("%02d", seq_len(12L)), 
        strrep("p", 220L)))
    handles <- list()
    owned <- NULL
    spill <- tempfile("scwb_graph_identity_live_slot_")
    on.exit({
        for (handle in handles) try(close(handle), silent = TRUE)
        if (!is.null(owned)) try(close(owned), silent = TRUE)
        unlink(c(root, spill), recursive = TRUE)
    }, add = TRUE)
    before <- scworkbench:::.wb_graph_transient_usage(budgets = policy)$owned_spill_bytes
    handles <- lapply(paths, function(path) file(path, "wb"))
    writeBin(raw(4096), spill)
    owned <- file(spill, "rb")
    usage <- scworkbench:::.wb_graph_transient_usage(budgets = policy)
    stopifnot(usage$owned_spill_bytes == before + 4096)
    unlink(spill)
    usage <- scworkbench:::.wb_graph_transient_usage(budgets = policy)
    stopifnot(usage$owned_spill_bytes == before + 4096)
    close(owned)
    owned <- NULL
    stopifnot(scworkbench:::.wb_graph_transient_usage(budgets = policy)$owned_spill_bytes == 
        before)
    TRUE
})
parse PASS
