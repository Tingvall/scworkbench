}, test_graph_resource_aggregate_cache_and_nested_policy_contract <- function() {
    bundle <- wb_init_bundle(tempfile("graph_aggregate_budget_"))
    policy <- scworkbench:::.wb_graph_budgets(list(memory_bytes = "8388608", 
        partition_bytes = 262144L, partition_rows = 256L, collect_bytes = 4194304L, 
        sqlite_cache_kib = 2048L))
    graph <- wb_prim_graph(list(list(node_id = "isolated")), 
        list(), list())
    stages <- lapply(1:2, function(i) scworkbench:::.wb_graph_stage_small(graph, 
        policy))
    connections <- c(list(bundle$con), lapply(stages, function(stage) stage$con))
    on.exit({
        for (stage in stages) scworkbench:::.wb_graph_stage_discard(stage)
        root <- bundle$dir
        wb_close_bundle(bundle)
        unlink(root, recursive = TRUE)
    }, add = TRUE)
    cache <- function() vapply(connections, function(con) DBI::dbGetQuery(con, 
        "PRAGMA cache_size;")[[1L]][[1L]], numeric(1))
    before <- cache()
    restore <- scworkbench:::.wb_graph_aggregate_connection_budget(connections, 
        policy)
    on.exit(restore(), add = TRUE)
    admitted <- cache()
    stopifnot(all(admitted < 0), sum(-admitted) * 1024 + 65536 <= 
        2048 * 1024)
    inner <- scworkbench:::.wb_graph_scoped_connection_budget(bundle$con, 
        scworkbench:::.wb_graph_budgets())
    stopifnot(identical(cache(), admitted), identical(scworkbench:::.wb_operation_pack_canonical_json(scworkbench:::.wb_graph_effective_budgets(bundle$con)), 
        scworkbench:::.wb_operation_pack_canonical_json(policy)))
    inner()
    branches <- character()
    hook <- options(scworkbench.graph_storage_test_hook = function(event, 
        evidence) {
        if (event != "identity_budget") 
            return(invisible(NULL))
        calls <- vapply(sys.calls(), function(call) paste(deparse(call), 
            collapse = " "), character(1))
        if (!any(grepl("wb_prov_payload_identity|wb_prov_write_snapshot", 
            calls))) 
            return(invisible(NULL))
        stopifnot(evidence$budgets$memory_bytes == "8388608", 
            evidence$budgets$partition_bytes == 262144, evidence$budgets$sqlite_cache_kib == 
                2048, -DBI::dbGetQuery(evidence$con, "PRAGMA cache_size;")[[1L]][[1L]] <= 
                max(-admitted))
        branches <<- c(branches, if (any(grepl("wb_graph_retained_identities", 
            calls))) "retained_reference" else if (identical(evidence$artifact_id, 
            "staged")) "stage_payload" else "published_certificate")
    })
    on.exit(options(hook), add = TRUE)
    attr(graph, "graph_stage") <- stages[[1L]]
    run <- wb_new_run("metadata_cell_vector", inputs = list(), 
        params = list(), outputs = list(vector = graph))
    promoted <- wb_promote_analysis(bundle, stats::setNames(list(run), 
        run$run_id), head_run_id = run$run_id, outputs = "vector")
    id <- promoted$promoted$artifact_id[[1L]]
    retained <- scworkbench:::.wb_graph_load_reference(bundle, 
        id)
    observed <- scworkbench:::.wb_prov_payload_identity(bundle, 
        retained)
    stopifnot(identical(observed$content_sha256, wb_graph_identity(graph)$content_identity$sha256), 
        identical(cache(), admitted), identical(bundle$con@ref$wb_graph_policy, 
            policy), all(c("stage_payload", "published_certificate", 
            "retained_reference") %in% branches))
    restore()
    stopifnot(identical(cache(), before), is.null(bundle$con@ref$wb_graph_policy))
    TRUE
