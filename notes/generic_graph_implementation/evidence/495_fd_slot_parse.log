        stopifnot(if (fault) 
            inherits(result, "error") && grepl("direct owned-stage fault", 
                conditionMessage(result), fixed = TRUE)
        else is.character(result), identical(before, list(cache = DBI::dbGetQuery(bundle$con, 
            "PRAGMA cache_size;")[[1L]][[1L]], policy = bundle$con@ref$wb_graph_policy, 
            cap = bundle$con@ref$wb_graph_cache_kib, temp = DBI::dbGetQuery(bundle$con, 
                "PRAGMA temp_store;")[[1L]][[1L]])), !any(file.exists(paths)))
    }
    options(scworkbench.promotion_transaction_test_hook = NULL)
    stopifnot(length(paths) == 2L)
    TRUE
